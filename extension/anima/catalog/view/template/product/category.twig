{{ header }}

<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  
  <div class="row">
    {% if column_left %}
      {{ column_left }}
    {% endif %}
    
    <div id="content" class="col">
      {{ content_top }}
      
      <h2>{{ heading_title }}</h2>
      
      {% if thumb or description %}
        <div class="row">
          {% if thumb %}
            <div class="col-sm-2">
              <img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" />
            </div>
          {% endif %}
          {% if description %}
            <div class="col-sm-10">{{ description }}</div>
          {% endif %}
        </div>
        <hr>
      {% endif %}
      
      {% if categories %}
        <h3>{{ text_refine }}</h3>
        <div class="row">
          {% for category in categories %}
            <div class="col-sm-3">
              <a href="{{ category.href }}">{{ category.name }}</a>
            </div>
          {% endfor %}
        </div>
        <hr>
      {% endif %}
      
      {% if products %}
        <div class="row mb-3">
          <div class="col-md-3 d-none d-md-block">
            <div class="btn-group">
              <button type="button" id="button-list" class="btn btn-light" data-bs-toggle="tooltip" title="{{ button_list }}">
                <i class="fa-solid fa-bars"></i>
              </button>
              <button type="button" id="button-grid" class="btn btn-light" data-bs-toggle="tooltip" title="{{ button_grid }}">
                <i class="fa-solid fa-grip"></i>
              </button>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="mb-3">
              <label for="input-sort" class="form-label">{{ text_sort }}</label>
              <select id="input-sort" class="form-select" onchange="location = this.value;">
                {% for key, value in sorts %}
                  <option value="{{ value }}"{% if key == sort %} selected{% endif %}>{{ key }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="mb-3">
              <label for="input-limit" class="form-label">{{ text_limit }}</label>
              <select id="input-limit" class="form-select" onchange="location = this.value;">
                {% for key, value in limits %}
                  <option value="{{ value }}"{% if key == limit %} selected{% endif %}>{{ key }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
        </div>
        
        <div id="product-list" class="products-grid row">
          {% for product in products %}
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
              <article class="product-card">
                <div class="product-info">
                  <div class="product-image">
                    <a href="{{ product.href }}">
                      <img src="{{ product.thumb }}" alt="{{ product.name }}" class="img-fluid" />
                    </a>
                    <button type="button" class="wishlist-btn" onclick="wishlist.add('{{ product.product_id }}');">
                      <img src="extension/anima/catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist" />
                    </button>
                    {% if product.special %}
                      <div class="product-badge">
                        <span class="badge-text">{{ text_sale }}</span>
                      </div>
                    {% endif %}
                  </div>
                  <div class="product-details">
                    <p class="product-name">
                      <a href="{{ product.href }}">{{ product.name }}</a>
                    </p>
                    {% if product.model %}
                      <div class="product-model">{{ product.model }}</div>
                    {% endif %}
                    {% if product.rating %}
                      <div class="rating">
                        {% for i in 1..5 %}
                          {% if product.rating < i %}
                            <span class="fa-stack"><i class="fa-regular fa-star fa-stack-1x"></i></span>
                          {% else %}
                            <span class="fa-stack"><i class="fa-solid fa-star fa-stack-1x"></i></span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="product-price">
                    {% if product.special %}
                      <span class="price-old">{{ product.price }}</span>
                      <span class="price-new">{{ product.special }}</span>
                    {% else %}
                      <span class="price">{{ product.price }}</span>
                    {% endif %}
                  </div>
                </div>
                <button type="button" class="add-to-cart-btn" onclick="cart.add('{{ product.product_id }}');">
                  {{ button_cart }}
                </button>
              </article>
            </div>
          {% endfor %}
        </div>
        
        <div class="row">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end">{{ results }}</div>
        </div>
      {% else %}
        <p>{{ text_empty }}</p>
      {% endif %}
      
      {{ content_bottom }}
    </div>
    
    {% if column_right %}
      {{ column_right }}
    {% endif %}
  </div>
</div>

{{ footer }}
