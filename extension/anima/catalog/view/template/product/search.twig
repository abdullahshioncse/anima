{{ header }}

<div class="desktop-2 screen">
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <!-- Search Form -->
  <div class="search-wrapper">
    <form action="{{ action }}" method="get">
      <div class="search-input">
        <input type="text" name="search" value="{{ search }}" placeholder="{{ text_search }}" class="form-control poppins-medium-eerie-black-16px" />
        <button type="submit" class="button-3">
          <img src="catalog/view/theme/extension/anima/image/iconly-sharp-search-1.svg" alt="Search" />
        </button>
      </div>
    </form>
  </div>
  
  <!-- Search Results -->
  {% if products %}
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/extension/anima/image/line-2-1.svg" alt="Line" />
    <p class="text-174">تم العثور على {{ product_count }} منتجًا</p>
    <img class="line" src="catalog/view/theme/extension/anima/image/line-2-1.svg" alt="Line" />
  </div>
  
  <div class="you-may-like">
    <div class="cards">
      {% for product in products %}
      <article class="card">
        <div class="info">
          <div class="image">
            <a href="{{ product.wishlist }}">
              <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-heart.svg" alt="Add to Wishlist" />
            </a>
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}" style="width: 100%; height: auto;" />
            </a>
          </div>
          <div class="info-1">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
        </div>
        <div class="button-1">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button poppins-semi-bold-white-16px">{{ text_add_to_cart|default('أضف إلى السلة') }}</div>
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
  
  {% if pagination %}
  <div class="pagination-wrapper">
    {{ pagination }}
  </div>
  {% endif %}
  {% else %}
  <div class="no-results">
    <p class="text poppins-medium-eerie-black-18px">{{ text_empty }}</p>
  </div>
  {% endif %}
</div>

{{ footer }}
