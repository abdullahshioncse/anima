{{ header }}

<div class="desktop-3 screen">
  <!-- Product Detail -->
  <div class="product-detail">
    <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <div class="product-info-wrapper">
      <!-- Product Images -->
      <div class="product-images">
        {% if thumb %}
        <div class="main-image">
          <img src="{{ thumb }}" alt="{{ heading_title }}" />
        </div>
        {% endif %}
        
        {% if images %}
        <div class="thumbnail-images">
          {% for image in images %}
          <img src="{{ image.thumb }}" alt="{{ heading_title }}" />
          {% endfor %}
        </div>
        {% endif %}
      </div>
      
      <!-- Product Info -->
      <div class="product-info">
        <div class="info-1 info-3">
          <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ heading_title }}</p>
          <div class="phone poppins-normal-eerie-black-12px">{{ text_product_code|default('كود المنتج') }}: {{ model }}</div>
        </div>
        
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
          {% if special %}
            <span class="price-old">{{ price }}</span>
            <span class="price-new">{{ special }}</span>
          {% else %}
            {{ price }}
          {% endif %}
        </div>
        
        <!-- Product Description -->
        {% if description %}
        <div class="product-description poppins-medium-eerie-black-18px">
          {{ description }}
        </div>
        {% endif %}
        
        <!-- Options -->
        {% if options %}
        <div class="product-options">
          {% for option in options %}
          <div class="form-group{{ option.required ? ' required' : '' }}">
            <label class="control-label">{{ option.name }}</label>
            {% if option.type == 'select' %}
            <select name="option[{{ option.product_option_id }}]" class="form-control">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                {% if option_value.price %}
                ({{ option_value.price_prefix }}{{ option_value.price }})
                {% endif %}
              </option>
              {% endfor %}
            </select>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
        
        <!-- Quantity -->
        <div class="form-group">
          <label class="control-label">{{ text_quantity|default('الكمية') }}</label>
          <input type="text" name="quantity" value="{{ minimum }}" size="2" class="form-control" />
        </div>
        
        <!-- Add to Cart Button -->
        <div class="button-1">
          <button type="button" id="button-cart" class="button-2 poppins-semi-bold-white-16px">
            {{ text_add_to_cart|default('أضف إلى السلة') }}
          </button>
        </div>
        
        <!-- Wishlist -->
        <div class="wishlist-button">
          <button type="button" onclick="wishlist.add('{{ product_id }}');">
            <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-heart.svg" alt="Add to Wishlist" />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
$('#button-cart').on('click', function() {
  $.ajax({
    url: 'index.php?route=checkout/cart.add',
    type: 'post',
    data: $('#product :input'),
    dataType: 'json',
    success: function(json) {
      if (json['redirect']) {
        location = json['redirect'];
      }
      
      if (json['success']) {
        $('#content').parent().before('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        
        $('#cart-total').html(json['total']);
      }
    }
  });
});
</script>

{{ footer }}
