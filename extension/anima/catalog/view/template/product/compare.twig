{{ header }}

<div id="product-compare" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  
  <h1>{{ heading_title }}</h1>
  
  {% if products %}
    <div class="table-responsive">
      <table class="table table-bordered">
        <thead>
          <tr>
            <td colspan="{{ products|length + 1 }}">{{ text_product }}</td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{{ text_name }}</td>
            {% for product in products %}
              <td>
                <a href="{{ product.href }}"><strong>{{ product.name }}</strong></a><br />
                <button type="button" onclick="compare.remove('{{ product.product_id }}');" class="btn btn-danger btn-sm">{{ button_remove }}</button>
              </td>
            {% endfor %}
          </tr>
          <tr>
            <td>{{ text_image }}</td>
            {% for product in products %}
              <td class="text-center">
                {% if product.thumb %}
                  <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-thumbnail" /></a>
                {% endif %}
              </td>
            {% endfor %}
          </tr>
          <tr>
            <td>{{ text_price }}</td>
            {% for product in products %}
              <td>
                {% if product.price %}
                  {% if product.special %}
                    <span class="price-old">{{ product.price }}</span>
                    <span class="price-new">{{ product.special }}</span>
                  {% else %}
                    <span class="price-new">{{ product.price }}</span>
                  {% endif %}
                {% endif %}
              </td>
            {% endfor %}
          </tr>
        </tbody>
        <tbody>
          {% for attribute in attributes %}
            <tr>
              <td>{{ attribute.name }}</td>
              {% for product in products %}
                <td>{{ attribute.product[product.product_id] ?: '' }}</td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
        <tbody>
          <tr>
            <td></td>
            {% for product in products %}
              <td>
                <button type="button" onclick="cart.add('{{ product.product_id }}');" class="btn btn-primary btn-block">{{ button_cart }}</button>
              </td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>
  {% else %}
    <p>{{ text_empty }}</p>
  {% endif %}
  
  {{ content_bottom }}
</div>

{{ footer }}
