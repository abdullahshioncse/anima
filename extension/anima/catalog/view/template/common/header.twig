<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}" />
  {% if description %}
    <meta name="description" content="{{ description }}" />
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}" />
  {% endif %}
  
  <!-- Styles -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  {% for style in styles %}
    <link href="{{ style.href }}" rel="stylesheet" media="{{ style.media }}" />
  {% endfor %}
  <link href="catalog/view/javascript/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
  <link href="{{ base }}extension/anima/catalog/view/stylesheet/anima.css" rel="stylesheet" type="text/css" />
  
  <!-- Scripts -->
  {% for script in scripts %}
    <script src="{{ script.href }}"></script>
  {% endfor %}
  <script src="catalog/view/javascript/jquery/jquery-3.6.0.min.js"></script>
  <script src="catalog/view/javascript/bootstrap/js/bootstrap.bundle.min.js"></script>
  
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}" />
  {% endfor %}
  
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
</head>
<body class="anima-theme">

<!-- Top Info Bar -->
<div class="info-bar">
  <div class="container-fluid">
    <div class="info-items">
      <div class="info-item">
        <img class="info-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-bag-2-1.svg" alt="Shopping" />
        <div class="info-content">
          <div class="info-title">الاسترجاع و التبديل</div>
          <p class="info-text">إمكانيه الأسترجاع في حال كان القياس غير مناسب</p>
        </div>
      </div>
      <div class="info-item">
        <img class="info-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-time-circle.svg" alt="Fast Delivery" />
        <div class="info-content">
          <div class="info-title">توصيل خلال ٢٤ ساعة</div>
          <p class="info-text">توصيل محلي لجميع مناطق الكويت خلال ٢٤ ساعه فقط ١ دينار كويتي من العبدلي الى الخيران</p>
        </div>
      </div>
      <div class="info-item">
        <img class="info-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-tick-square.svg" alt="Original Products" />
        <div class="info-content">
          <div class="info-title">منتجات أصلية 100%</div>
          <p class="info-text">جميع المنتجات الأصلية من المصنع مباشره ملابس رياضية - أكسسوارات لتمارين</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sale Banner -->
<div class="sale-banner">
  <p class="sale-text">حصل على خصم 20٪ قبل نهاية نوفمبر!</p>
</div>

<!-- Header -->
<header class="header-main">
  <div class="container-fluid">
    <div class="header-wrapper">
      <!-- Navigation Menu -->
      <nav class="navbar-menu">
        {% if categories %}
          {% for category in categories %}
            <a href="{{ category.href }}" class="navbar-link">{{ category.name }}</a>
          {% endfor %}
        {% else %}
          <a href="#" class="navbar-link">ملابس رجالية</a>
          <a href="#" class="navbar-link">ملابس نسائية</a>
          <a href="#" class="navbar-link">إكسسوارات</a>
          <a href="#" class="navbar-link">تخفيضات</a>
        {% endif %}
      </nav>

      <!-- Logo -->
      <div class="logo">
        {% if logo %}
          <a href="{{ home }}"><img src="{{ logo }}" alt="{{ name }}" /></a>
        {% else %}
          <a href="{{ home }}" class="logo-text">{{ name }}</a>
        {% endif %}
      </div>

      <!-- Header Menu Icons -->
      <div class="header-menu">
        <!-- Phone Number -->
        <div class="phone-wrapper">
          <img class="menu-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-call.svg" alt="Call" />
          <div class="phone-number">{{ telephone ?: '965-22091914' }}</div>
        </div>
        
        <!-- Search -->
        <a href="{{ search }}" class="menu-icon-link">
          <img class="menu-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-search-1.svg" alt="Search" />
        </a>
        
        <!-- Wishlist -->
        <a href="{{ wishlist }}" class="menu-icon-link" id="wishlist-total">
          <img class="menu-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist" />
          {% if wishlist_total %}
            <span class="badge">{{ wishlist_total }}</span>
          {% endif %}
        </a>
        
        <!-- Cart -->
        <a href="{{ shopping_cart }}" class="menu-icon-link" id="cart-total">
          <img class="menu-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-bag-2.svg" alt="Cart" />
          {% if cart_total %}
            <span class="badge">{{ cart_total }}</span>
          {% endif %}
        </a>
        
        <!-- Account -->
        <a href="{{ account }}" class="menu-icon-link">
          <img class="menu-icon" src="{{ base }}{{ base }}extension/anima/catalog/view/image/iconly-sharp-profile.svg" alt="Account" />
        </a>
      </div>
    </div>
  </div>
</header>
