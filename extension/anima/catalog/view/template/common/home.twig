{{ header }}

<div class="desktop-1 screen">
  <!-- Info Section - Benefits -->
  <div class="info-2">
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-bag-2-1.svg" alt="Returns & Exchange" />
      <div class="info-3">
        <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_returns_exchange|default('الاسترجاع و التبديل') }}</div>
        <p class="text poppins-normal-white-12px">{{ text_returns_exchange_desc|default('إمكانيه الأسترجاع في حال كان القياس غير مناسب') }}</p>
      </div>
    </div>
    <div class="x2">
      <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-time-circle.svg" alt="24 Hour Delivery" />
      <div class="info-4">
        <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_24h_delivery|default('توصيل خلال ٢٤ ساعة') }}</div>
        <p class="text poppins-normal-white-12px">
          {{ text_24h_delivery_desc|default('توصيل محلي لجميع مناطق الكويت خلال ٢٤ ساعه فقط ١ دينار كويتي من العبدلي الى الخيران') }}
        </p>
      </div>
    </div>
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-tick-square.svg" alt="100% Authentic" />
      <div class="info">
        <div class="text-41 text-5 poppins-semi-bold-white-16px">{{ text_authentic_products|default('منتجات أصلية 100%') }}</div>
        <p class="text-42 text-5 poppins-normal-white-12px">
          {{ text_authentic_desc|default('جميع المنتجات الأصلية من المصنع مباشره ملابس رياضية - أكسسوارات لتمارين') }}
        </p>
      </div>
    </div>
  </div>

  <!-- Hero Banner -->
  <img class="rectangle-5" src="catalog/view/theme/extension/anima/image/rectangle-5-1.png" alt="Hero Banner" />
  <div class="main">
    <h1 class="text-48 text-5">{{ text_shop_now|default('تسوّق الآن') }}</h1>
    <div class="buttons">
      <article class="button-3"><div class="button poppins-medium-white-16px">{{ text_view_details|default('عرض التفاصيل') }}</div></article>
      <article class="button-4"><div class="button poppins-semi-bold-white-16px">{{ text_start_shopping|default('ابدأ التسوّق') }}</div></article>
    </div>
    <div class="way">
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-1162-1"></div>
    </div>
  </div>

  <!-- You May Like Section -->
  <div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ text_you_may_like|default('منتجات قد تعجبك') }}</div>
    <div class="cards">
      {% for product in products_featured %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.wishlist }}">
              <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-heart.svg" alt="Add to Wishlist" />
            </a>
            {% if product.special %}
            <div class="frame-5 frame">
              <div class="button-1"><div class="button-5 poppins-medium-white-14px">{{ text_new_collection|default('مجموعة جديدة') }}</div></div>
            </div>
            {% endif %}
            <img src="{{ product.thumb }}" alt="{{ product.name }}" style="width: 100%; height: auto;" />
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
        </div>
        <div class="button-2">
          <a href="{{ product.href }}">
            <div class="button poppins-semi-bold-white-16px">{{ text_add_to_cart|default('أضف إلى السلة') }}</div>
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="way-3">
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-1162"></div>
    </div>
  </div>

  <!-- Arrows for carousel -->
  <div class="arrows">
    <div class="left">
      <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-arrow---left.svg" alt="Left Arrow" />
    </div>
    <div class="right">
      <img class="iconly-sharp-arrow-left" src="catalog/view/theme/extension/anima/image/iconly-sharp-arrow---left-1.svg" alt="Right Arrow" />
    </div>
  </div>

  <!-- New In Section -->
  <div class="new-in">
    <div class="new-in-1">
      <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ text_new_in|default('وصل حديثًا') }}</div>
      <div class="categories poppins-normal-eerie-black-16px">
        <div class="text-51 text-5">{{ text_accessories|default('إكسسوارات') }}</div>
        <div class="text-52 text-5">{{ text_womens_clothing|default('ملابس نسائية') }}</div>
        <div class="active">
          <div class="text-53 text-5 poppins-semi-bold-eerie-black-16px">{{ text_mens_clothing|default('ملابس رجالية') }}</div>
          <img class="line-1" src="catalog/view/theme/extension/anima/image/line-1-1.svg" alt="Active Indicator" />
        </div>
      </div>
    </div>
    <div class="cards">
      {% for product in products_latest %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.wishlist }}">
              <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-heart.svg" alt="Add to Wishlist" />
            </a>
            <div class="frame-5-1">
              <div class="button-1"><div class="button-9 poppins-medium-white-14px">{{ text_new_collection|default('مجموعة جديدة') }}</div></div>
            </div>
            <img src="{{ product.thumb }}" alt="{{ product.name }}" style="width: 100%; height: auto;" />
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
        </div>
        <div class="button-2">
          <a href="{{ product.href }}">
            <div class="button poppins-semi-bold-white-16px">{{ text_add_to_cart|default('أضف إلى السلة') }}</div>
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="way-3">
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-1162"></div>
    </div>
    <div class="button-1"><div class="button-13 poppins-medium-white-14px">عرض الكل</div></div>
  </div>

  <!-- Arrows for new in carousel -->
  <div class="arrows-1">
    <div class="left">
      <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-arrow---left.svg" alt="Left Arrow" />
    </div>
    <div class="right">
      <img class="iconly-sharp-arrow-left" src="catalog/view/theme/extension/anima/image/iconly-sharp-arrow---left-1.svg" alt="Right Arrow" />
    </div>
  </div>

  <img class="line-2" src="catalog/view/theme/extension/anima/image/line-2-1.svg" alt="Divider Line" />
</div>

{{ footer }}
