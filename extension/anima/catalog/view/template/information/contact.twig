{{ header }}

<div id="information-contact" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  
  <div class="row">
    <div id="content" class="col">
      {{ content_top }}
      
      <h1>{{ heading_title }}</h1>
      
      <div class="row">
        <div class="col-sm-6">
          <fieldset>
            <legend>{{ text_location }}</legend>
            <div class="mb-3">
              <strong>{{ store }}</strong><br />
              {{ address }}
            </div>
            <div class="mb-3">
              <strong>{{ text_telephone }}</strong><br />
              {{ telephone }}
            </div>
            {% if fax %}
              <div class="mb-3">
                <strong>{{ text_fax }}</strong><br />
                {{ fax }}
              </div>
            {% endif %}
          </fieldset>
        </div>
        <div class="col-sm-6">
          <fieldset>
            <legend>{{ text_contact }}</legend>
            <form id="form-contact">
              <div class="mb-3 required">
                <label for="input-name" class="form-label">{{ entry_name }}</label>
                <input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" />
              </div>
              <div class="mb-3 required">
                <label for="input-email" class="form-label">{{ entry_email }}</label>
                <input type="text" name="email" value="{{ email }}" id="input-email" class="form-control" />
              </div>
              <div class="mb-3 required">
                <label for="input-enquiry" class="form-label">{{ entry_enquiry }}</label>
                <textarea name="enquiry" rows="10" id="input-enquiry" class="form-control">{{ enquiry }}</textarea>
              </div>
              {{ captcha }}
              <div class="text-end">
                <button type="submit" class="btn btn-primary">{{ button_submit }}</button>
              </div>
            </form>
          </fieldset>
        </div>
      </div>
      
      {{ content_bottom }}
    </div>
  </div>
</div>

{{ footer }}
