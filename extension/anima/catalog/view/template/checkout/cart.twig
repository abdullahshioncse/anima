{{ header }}

<div class="desktop-4 screen">
  <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ text_cart|default('عربة التسوق') }}</h1>
  
  {% if products or vouchers %}
  <div class="cart-content">
    <div class="cart-items">
      {% for product in products %}
      <div class="cart-item card">
        <div class="info">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}" />
            </a>
          </div>
          <div class="info-1 info-3">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            
            {% if product.option %}
            {% for option in product.option %}
            <div class="product-option">
              <small>{{ option.name }}: {{ option.value }}</small>
            </div>
            {% endfor %}
            {% endif %}
          </div>
          
          <div class="quantity-controls">
            <label>{{ text_quantity|default('الكمية') }}:</label>
            <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="form-control" />
            <button type="button" onclick="cart.update('{{ product.cart_id }}', document.querySelector('input[name=\'quantity[{{ product.cart_id }}]\']').value);">
              <img src="catalog/view/theme/extension/anima/image/iconly-sharp-edit.svg" alt="Update" />
            </button>
            <button type="button" onclick="cart.remove('{{ product.cart_id }}');">
              <img src="catalog/view/theme/extension/anima/image/iconly-sharp-delete.svg" alt="Remove" />
            </button>
          </div>
          
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.total }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
    
    <!-- Cart Totals -->
    <div class="cart-totals">
      {% for total in totals %}
      <div class="total-row">
        <span class="total-label poppins-medium-eerie-black-16px">{{ total.title }}:</span>
        <span class="total-value poppins-semi-bold-eerie-black-16px">{{ total.text }}</span>
      </div>
      {% endfor %}
    </div>
    
    <!-- Checkout Button -->
    <div class="button-1">
      <a href="{{ checkout }}" class="button-2 poppins-semi-bold-white-16px">
        {{ text_checkout|default('إتمام الطلب') }}
      </a>
    </div>
    
    <div class="button-1">
      <a href="{{ continue }}" class="button poppins-medium-white-16px">
        {{ text_continue|default('متابعة التسوق') }}
      </a>
    </div>
  </div>
  {% else %}
  <div class="empty-cart">
    <p class="text poppins-medium-eerie-black-18px">{{ text_empty }}</p>
    <div class="button-1">
      <a href="{{ continue }}" class="button poppins-semi-bold-white-16px">
        {{ text_continue|default('متابعة التسوق') }}
      </a>
    </div>
  </div>
  {% endif %}
</div>

{{ footer }}
