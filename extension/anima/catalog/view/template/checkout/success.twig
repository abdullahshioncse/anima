{{ header }}

<div id="checkout-success" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  
  <div class="row">
    <div id="content" class="col">
      {{ content_top }}
      
      <h1>{{ heading_title }}</h1>
      
      {{ text_message }}
      
      {% if customer %}
        <p>{{ text_customer }}</p>
      {% endif %}
      
      <div class="buttons">
        <div class="float-end">
          <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
        </div>
      </div>
      
      {{ content_bottom }}
    </div>
  </div>
</div>

{{ footer }}
