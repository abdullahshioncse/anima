{{ header }}

<div class="iphone-13-u38-14-1 screen">
  <div class="wishlist-wrapper">
    <h1 class="text-271 text">{{ heading_title }}</h1>
    
    {% if products %}
    <div class="wishlist-items">
      {% for product in products %}
      <div class="wishlist-item card">
        <div class="info">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}" />
            </a>
            <button type="button" onclick="wishlist.remove('{{ product.product_id }}');">
              <img class="iconly-sharp" src="catalog/view/theme/extension/anima/image/iconly-sharp-delete.svg" alt="Remove" />
            </button>
          </div>
          <div class="info-1 info-3">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
        </div>
        <div class="button-1">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button poppins-semi-bold-white-16px">{{ text_add_to_cart|default('أضف إلى السلة') }}</div>
          </button>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-wishlist">
      <p class="text poppins-medium-eerie-black-18px">{{ text_empty }}</p>
      <div class="button-1">
        <a href="{{ continue }}" class="button poppins-semi-bold-white-16px">
          {{ text_continue|default('متابعة التسوق') }}
        </a>
      </div>
    </div>
    {% endif %}
  </div>
</div>

{{ footer }}
