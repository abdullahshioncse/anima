{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-theme" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    <div class="card">
      <div class="card-header">
        <i class="fa-solid fa-pencil"></i> {{ text_edit }}
      </div>
      <div class="card-body">
        <form id="form-theme" action="{{ action }}" method="post" data-oc-toggle="ajax">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">General</a></li>
            <li class="nav-item"><a href="#tab-image" data-bs-toggle="tab" class="nav-link">Image</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="theme_anima_status" value="0"/>
                    <input type="checkbox" name="theme_anima_status" value="1" id="input-status" class="form-check-input"{% if theme_anima_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-product-limit" class="col-sm-2 col-form-label">{{ entry_product_limit }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_product_limit" value="{{ theme_anima_product_limit }}" placeholder="{{ entry_product_limit }}" id="input-product-limit" class="form-control"/>
                  <div class="form-text">{{ help_product_limit }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-product-description-length" class="col-sm-2 col-form-label">{{ entry_product_description_length }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_product_description_length" value="{{ theme_anima_product_description_length }}" placeholder="{{ entry_product_description_length }}" id="input-product-description-length" class="form-control"/>
                  <div class="form-text">{{ help_product_description_length }}</div>
                </div>
              </div>
            </div>
            <div id="tab-image" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_category }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_category_width" value="{{ theme_anima_image_category_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_category_height" value="{{ theme_anima_image_category_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_thumb }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_thumb_width" value="{{ theme_anima_image_thumb_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_thumb_height" value="{{ theme_anima_image_thumb_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_popup }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_popup_width" value="{{ theme_anima_image_popup_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_popup_height" value="{{ theme_anima_image_popup_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_product }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_product_width" value="{{ theme_anima_image_product_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_product_height" value="{{ theme_anima_image_product_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_additional }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_additional_width" value="{{ theme_anima_image_additional_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_additional_height" value="{{ theme_anima_image_additional_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_related }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_related_width" value="{{ theme_anima_image_related_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_related_height" value="{{ theme_anima_image_related_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_compare }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_compare_width" value="{{ theme_anima_image_compare_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_compare_height" value="{{ theme_anima_image_compare_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_wishlist }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_wishlist_width" value="{{ theme_anima_image_wishlist_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_wishlist_height" value="{{ theme_anima_image_wishlist_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_cart }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_cart_width" value="{{ theme_anima_image_cart_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_cart_height" value="{{ theme_anima_image_cart_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_image_location }}</label>
                <div class="col-sm-10">
                  <div class="row">
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_location_width" value="{{ theme_anima_image_location_width }}" placeholder="{{ entry_width }}" class="form-control"/>
                    </div>
                    <div class="col-sm-6">
                      <input type="text" name="theme_anima_image_location_height" value="{{ theme_anima_image_location_height }}" placeholder="{{ entry_height }}" class="form-control"/>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
