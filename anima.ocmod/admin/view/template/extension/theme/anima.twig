{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-theme" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <i class="fa-solid fa-pencil"></i> {{ text_edit }}
      </div>
      <div class="card-body">
        <form id="form-theme" action="{{ save }}" method="post" data-oc-toggle="ajax">
          
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">General</a></li>
            <li class="nav-item"><a href="#tab-image" data-bs-toggle="tab" class="nav-link">Image Settings</a></li>
            <li class="nav-item"><a href="#tab-product" data-bs-toggle="tab" class="nav-link">Product Display</a></li>
            <li class="nav-item"><a href="#tab-style" data-bs-toggle="tab" class="nav-link">Style & Colors</a></li>
          </ul>
          
          <div class="tab-content">
            
            <!-- General Tab -->
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="theme_anima_status" value="0"/>
                    <input type="checkbox" name="theme_anima_status" value="1" id="input-status" class="form-check-input"{% if theme_anima_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              
              <div class="row mb-3">
                <label for="input-phone" class="col-sm-2 col-form-label">{{ entry_phone }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_phone" value="{{ theme_anima_phone }}" placeholder="{{ entry_phone }}" id="input-phone" class="form-control"/>
                </div>
              </div>
              
              <div class="row mb-3">
                <label for="input-sale-banner" class="col-sm-2 col-form-label">{{ entry_sale_banner_text }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_sale_banner_text" value="{{ theme_anima_sale_banner_text }}" placeholder="{{ entry_sale_banner_text }}" id="input-sale-banner" class="form-control"/>
                </div>
              </div>
            </div>
            
            <!-- Image Settings Tab -->
            <div id="tab-image" class="tab-pane">
              <fieldset>
                <legend>Category Images</legend>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_category_width }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_category_width" value="{{ theme_anima_image_category_width }}" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_category_height }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_category_height" value="{{ theme_anima_image_category_height }}" class="form-control"/>
                  </div>
                </div>
              </fieldset>
              
              <fieldset>
                <legend>Product Images</legend>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_product_width }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_product_width" value="{{ theme_anima_image_product_width }}" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_product_height }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_product_height" value="{{ theme_anima_image_product_height }}" class="form-control"/>
                  </div>
                </div>
              </fieldset>
              
              <fieldset>
                <legend>Thumbnail Images</legend>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_thumb_width }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_thumb_width" value="{{ theme_anima_image_thumb_width }}" class="form-control"/>
                  </div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label">{{ entry_image_thumb_height }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="theme_anima_image_thumb_height" value="{{ theme_anima_image_thumb_height }}" class="form-control"/>
                  </div>
                </div>
              </fieldset>
            </div>
            
            <!-- Product Display Tab -->
            <div id="tab-product" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_product_limit }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_product_limit" value="{{ theme_anima_product_limit }}" class="form-control"/>
                  <div class="form-text">{{ help_product }}</div>
                </div>
              </div>
              
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_product_per_row }}</label>
                <div class="col-sm-10">
                  <select name="theme_anima_product_per_row" class="form-select">
                    <option value="2"{% if theme_anima_product_per_row == 2 %} selected{% endif %}>2</option>
                    <option value="3"{% if theme_anima_product_per_row == 3 %} selected{% endif %}>3</option>
                    <option value="4"{% if theme_anima_product_per_row == 4 %} selected{% endif %}>4</option>
                    <option value="5"{% if theme_anima_product_per_row == 5 %} selected{% endif %}>5</option>
                    <option value="6"{% if theme_anima_product_per_row == 6 %} selected{% endif %}>6</option>
                  </select>
                </div>
              </div>
            </div>
            
            <!-- Style & Colors Tab -->
            <div id="tab-style" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_primary_color }}</label>
                <div class="col-sm-10">
                  <input type="color" name="theme_anima_primary_color" value="{{ theme_anima_primary_color }}" class="form-control form-control-color"/>
                  <div class="form-text">{{ help_colors }}</div>
                </div>
              </div>
              
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_secondary_color }}</label>
                <div class="col-sm-10">
                  <input type="color" name="theme_anima_secondary_color" value="{{ theme_anima_secondary_color }}" class="form-control form-control-color"/>
                </div>
              </div>
              
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_font_family }}</label>
                <div class="col-sm-10">
                  <input type="text" name="theme_anima_font_family" value="{{ theme_anima_font_family }}" class="form-control"/>
                  <div class="form-text">{{ help_typography }}</div>
                </div>
              </div>
              
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_custom_css }}</label>
                <div class="col-sm-10">
                  <textarea name="theme_anima_custom_css" rows="10" class="form-control">{{ theme_anima_custom_css }}</textarea>
                  <div class="form-text">{{ help_custom_css }}</div>
                </div>
              </div>
            </div>
            
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
