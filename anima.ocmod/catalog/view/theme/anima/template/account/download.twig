{{ header }}

<div id="account-download" class="container">
  <h1>{{ heading_title }}</h1>
  
  {% if downloads %}
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <td class="text-left">{{ column_name }}</td>
        <td class="text-right">{{ column_size }}</td>
        <td class="text-left">{{ column_date_added }}</td>
        <td></td>
      </tr>
    </thead>
    <tbody>
      {% for download in downloads %}
      <tr>
        <td class="text-left">{{ download.name }}</td>
        <td class="text-right">{{ download.size }}</td>
        <td class="text-left">{{ download.date_added }}</td>
        <td class="text-right">
          <a href="{{ download.href }}" class="btn btn-primary"><i class="fa fa-download"></i> {{ button_download }}</a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  
  {{ pagination }}
  {% else %}
  <p>{{ text_empty }}</p>
  {% endif %}
  
  <div class="buttons clearfix">
    <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
  </div>
</div>

{{ footer }}
