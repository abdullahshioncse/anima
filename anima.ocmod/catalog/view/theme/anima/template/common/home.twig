<!-- Home Page Content -->
<div id="common-home" class="container">
  
  <!-- Main Hero Section -->
  <div class="main">
    <img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="Hero Banner" />
    <h1 class="text">{{ heading_title }}</h1>
    <div class="buttons">
      <article class="button-3">
        <a href="{{ categories_link }}" class="button poppins-medium-white-16px">{{ text_view_details }}</a>
      </article>
      <article class="button-4">
        <a href="{{ products_link }}" class="button poppins-semi-bold-white-16px">{{ text_shop_now }}</a>
      </article>
    </div>
    <div class="way">
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-1162-1"></div>
    </div>
  </div>
  
  <!-- Info Section -->
  <div class="info-2">
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2-1.svg" alt="Returns" />
      <div class="info-3">
        <div class="text-3 poppins-semi-bold-white-16px">{{ text_returns }}</div>
        <p class="text poppins-normal-white-12px">{{ text_returns_desc }}</p>
      </div>
    </div>
    <div class="x2">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-time-circle.svg" alt="Delivery" />
      <div class="info-4">
        <div class="text-3 poppins-semi-bold-white-16px">{{ text_delivery }}</div>
        <p class="text poppins-normal-white-12px">{{ text_delivery_desc }}</p>
      </div>
    </div>
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="Authentic" />
      <div class="info">
        <div class="text poppins-semi-bold-white-16px">{{ text_authentic }}</div>
        <p class="text poppins-normal-white-12px">{{ text_authentic_desc }}</p>
      </div>
    </div>
  </div>
  
  {{ content_top }}
  {{ content_bottom }}
  
</div>
