<div class="payment-methods">
  {% if error_warning %}
  <div class="alert alert-warning">{{ error_warning }}</div>
  {% endif %}
  
  {% if payment_methods %}
  <p>{{ text_payment_method }}</p>
  {% for payment_method in payment_methods %}
  <div class="radio">
    <label>
      <input type="radio" name="payment_method" value="{{ payment_method.code }}"{% if payment_method.code == code %} checked{% endif %} />
      {{ payment_method.title }}
    </label>
  </div>
  {% endfor %}
  {% endif %}
  
  {% if text_comments %}
  <p><strong>{{ text_comments }}</strong></p>
  <textarea name="comment" rows="8" class="form-control">{{ comment }}</textarea>
  {% endif %}
  
  {% if text_agree %}
  <div class="checkbox">
    <label>
      <input type="checkbox" name="agree" value="1"{% if agree %} checked{% endif %} />
      {{ text_agree }}
    </label>
  </div>
  {% endif %}
  
  <div class="buttons">
    <div class="pull-right">
      <input type="button" value="{{ button_continue }}" id="button-payment-method" class="btn btn-primary" />
    </div>
  </div>
</div>
