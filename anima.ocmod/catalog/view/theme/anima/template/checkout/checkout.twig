{{ header }}

<div id="checkout-checkout" class="container">
  <h1>{{ heading_title }}</h1>
  <div class="panel-group" id="accordion">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_option }}</h4>
      </div>
      <div class="panel-collapse collapse in">
        <div class="panel-body" id="collapse-checkout-option"></div>
      </div>
    </div>
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_account }}</h4>
      </div>
      <div class="panel-collapse collapse">
        <div class="panel-body" id="collapse-payment-address"></div>
      </div>
    </div>
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_payment_address }}</h4>
      </div>
      <div class="panel-collapse collapse">
        <div class="panel-body" id="collapse-shipping-address"></div>
      </div>
    </div>
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_shipping_method }}</h4>
      </div>
      <div class="panel-collapse collapse">
        <div class="panel-body" id="collapse-shipping-method"></div>
      </div>
    </div>
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_payment_method }}</h4>
      </div>
      <div class="panel-collapse collapse">
        <div class="panel-body" id="collapse-payment-method"></div>
      </div>
    </div>
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h4 class="panel-title">{{ text_checkout_confirm }}</h4>
      </div>
      <div class="panel-collapse collapse">
        <div class="panel-body" id="collapse-checkout-confirm"></div>
      </div>
    </div>
  </div>
</div>

{{ footer }}
