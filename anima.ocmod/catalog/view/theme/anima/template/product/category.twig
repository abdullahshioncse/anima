{{ header }}

<div id="product-category" class="container">
  
  <!-- Page Title -->
  <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <!-- Product Count -->
  {% if results %}
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
    <p class="text">{{ text_results }}</p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
  </div>
  {% endif %}
  
  <!-- Filter and Sort -->
  <div class="product-filter">
    <div class="form-group">
      <label for="input-sort">{{ text_sort }}</label>
      <select id="input-sort" class="form-control" onchange="location = this.value;">
        {% for sort_option in sorts %}
        <option value="{{ sort_option.href }}"{% if sort_option.value == sort ~ '-' ~ order %} selected{% endif %}>{{ sort_option.text }}</option>
        {% endfor %}
      </select>
    </div>
    
    <div class="form-group">
      <label for="input-limit">{{ text_limit }}</label>
      <select id="input-limit" class="form-control" onchange="location = this.value;">
        {% for limit_option in limits %}
        <option value="{{ limit_option.href }}"{% if limit_option.value == limit %} selected{% endif %}>{{ limit_option.text }}</option>
        {% endfor %}
      </select>
    </div>
  </div>
  
  <!-- Products Grid -->
  {% if products %}
  <div class="cards">
    {% for product in products %}
    <article class="card">
      <div class="info-1">
        <div class="image">
          <a href="{{ product.href }}">
            {% if product.thumb %}
            <img src="{{ product.thumb }}" alt="{{ product.name }}" />
            {% endif %}
          </a>
          <a href="{{ product.wishlist }}" class="wishlist-btn" title="{{ button_wishlist }}">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" />
          </a>
          {% if product.special %}
          <div class="frame-5 frame">
            <div class="button-1">
              <div class="button poppins-medium-white-14px">{{ text_sale }}</div>
            </div>
          </div>
          {% endif %}
        </div>
        
        <div class="info">
          <a href="{{ product.href }}">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</p>
          </a>
          {% if product.model %}
          <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          {% endif %}
        </div>
        
        <div class="price">
          {% if product.special %}
          <span class="price-old">{{ product.price }}</span>
          <span class="price-new poppins-semi-bold-eerie-black-16px">{{ product.special }}</span>
          {% else %}
          <span class="price-current poppins-semi-bold-eerie-black-16px">{{ product.price }}</span>
          {% endif %}
        </div>
      </div>
      
      <div class="button-2">
        <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button poppins-semi-bold-white-16px">
          {{ button_cart }}
        </button>
      </div>
    </article>
    {% endfor %}
  </div>
  
  <!-- Pagination -->
  {{ pagination }}
  
  {% else %}
  <p class="text-center">{{ text_empty }}</p>
  {% endif %}
  
  <!-- Category Description -->
  {% if description %}
  <div class="category-description">
    {{ description }}
  </div>
  {% endif %}
  
</div>

{{ footer }}
