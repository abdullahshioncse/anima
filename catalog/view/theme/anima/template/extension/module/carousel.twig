{% if banners %}
<div class="carousel-module">
    <div class="carousel-wrapper" id="carousel-{{ module }}">
        {% for banner in banners %}
        <div class="carousel-item {% if loop.first %}active{% endif %}">
            {% if banner.link %}
            <a href="{{ banner.link }}">
                <img src="{{ banner.image }}" alt="{{ banner.title }}" class="rectangle-5" />
            </a>
            {% else %}
            <img src="{{ banner.image }}" alt="{{ banner.title }}" class="rectangle-5" />
            {% endif %}
        </div>
        {% endfor %}
    </div>
    
    <!-- Carousel Navigation -->
    <div class="way">
        {% for banner in banners %}
        <div class="rectangle-116{% if loop.last %}2-1{% endif %}" data-index="{{ loop.index0 }}"></div>
        {% endfor %}
    </div>
    
    <div class="carousel-controls">
        <div class="left carousel-prev">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="Previous" />
        </div>
        <div class="right carousel-next">
            <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="Next" />
        </div>
    </div>
</div>

<script type="text/javascript">
(function() {
    var carousel = document.getElementById('carousel-{{ module }}');
    var items = carousel.querySelectorAll('.carousel-item');
    var dots = carousel.parentElement.querySelectorAll('.way div');
    var currentIndex = 0;
    var interval;
    
    function showSlide(index) {
        items.forEach(function(item, i) {
            item.classList.remove('active');
            if (dots[i]) {
                dots[i].classList.remove('rectangle-1162-1');
                dots[i].classList.add('rectangle-116');
            }
        });
        
        items[index].classList.add('active');
        if (dots[index]) {
            dots[index].classList.remove('rectangle-116');
            dots[index].classList.add('rectangle-1162-1');
        }
        currentIndex = index;
    }
    
    function nextSlide() {
        var next = (currentIndex + 1) % items.length;
        showSlide(next);
    }
    
    function prevSlide() {
        var prev = (currentIndex - 1 + items.length) % items.length;
        showSlide(prev);
    }
    
    // Auto-play
    interval = setInterval(nextSlide, 5000);
    
    // Navigation
    var nextBtn = carousel.parentElement.querySelector('.carousel-next');
    var prevBtn = carousel.parentElement.querySelector('.carousel-prev');
    
    if (nextBtn) {
        nextBtn.addEventListener('click', function() {
            clearInterval(interval);
            nextSlide();
            interval = setInterval(nextSlide, 5000);
        });
    }
    
    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            clearInterval(interval);
            prevSlide();
            interval = setInterval(nextSlide, 5000);
        });
    }
    
    // Dots
    dots.forEach(function(dot, i) {
        dot.addEventListener('click', function() {
            clearInterval(interval);
            showSlide(i);
            interval = setInterval(nextSlide, 5000);
        });
    });
})();
</script>
{% endif %}
