{% if products %}
<div class="carousel-module" id="carousel-{{ module_id|default('1') }}">
    {% if heading_title %}
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</div>
    {% endif %}
    
    <div class="carousel-container">
        <div class="carousel-track" data-autoplay="{{ autoplay|default(true) }}" data-interval="{{ interval|default(5000) }}">
            {% for product in products %}
            <article class="card carousel-slide">
                <div class="info-1">
                    <div class="image" style="background-image: url('{{ product.thumb }}');">
                        <a href="javascript:void(0);" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-btn">
                            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist|default('Wishlist') }}" />
                        </a>
                        {% if product.labels|default([])|length > 0 %}
                        <div class="frame-5">
                            {% for label in product.labels %}
                            <div class="button-1"><div class="button-5 poppins-medium-white-14px {{ label.class }}">{{ label.text }}</div></div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    <div class="info">
                        <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                        <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                    </div>
                    <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                        {% if product.special %}
                        <span class="price-old">{{ product.original_price }}</span>
                        {% endif %}
                        {{ product.price }}
                    </div>
                </div>
                <div class="button-2" onclick="cart.add('{{ product.product_id }}');">
                    <div class="button poppins-semi-bold-white-16px">{{ button_cart|default('أضف إلى السلة') }}</div>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
    
    <div class="arrows">
        <div class="left carousel-prev" onclick="carouselPrev('carousel-{{ module_id|default('1') }}')">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="{{ text_prev|default('Previous') }}" />
        </div>
        <div class="right carousel-next" onclick="carouselNext('carousel-{{ module_id|default('1') }}')">
            <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="{{ text_next|default('Next') }}" />
        </div>
    </div>
    
    <div class="way-3 carousel-dots">
        {% for product in products %}
        <div class="rectangle-116-1 carousel-dot{% if loop.last %} rectangle-1162{% endif %}" data-index="{{ loop.index0 }}"></div>
        {% endfor %}
    </div>
</div>
{% endif %}
