<!-- Footer -->
<footer class="footer">
    <div class="email">
        <p class="text-54 text-5 poppins-semi-bold-white-24px">{{ newsletter_title|default('هل ترغب في الاشتراك في نشرتنا الإخبارية؟') }}</p>
        <form class="email-1 newsletter-form" method="post">
            <button type="submit" class="button-14">
                <span class="button-15 poppins-semi-bold-white-14px">إرسال</span>
            </button>
            <input type="email" name="email" class="text-55 text-5 poppins-medium-eerie-black-16px" placeholder="البريد الإلكتروني" required />
        </form>
    </div>
    
    <div class="info-5">
        <div class="menu-2">
            <div class="payment-icons-2">
                <article class="payment-icons"></article>
                <article class="payment-icons"></article>
                <article class="payment-icons-1">
                    <img class="visa-logo" src="catalog/view/theme/anima/image/visa-logo-1.svg" alt="Visa" />
                </article>
                <article class="payment-icons-1">
                    <img class="apple-pay" src="catalog/view/theme/anima/image/applepay-1.svg" alt="ApplePay" />
                </article>
                <article class="payment-icons-1">
                    <img class="mastercard" src="catalog/view/theme/anima/image/mastercard-1@2x.png" alt="Mastercard" />
                </article>
            </div>
            
            <div class="menu-3">
                <div class="menu-item">
                    <div class="menu">
                        <div class="text-56 text-5 poppins-bold-white-18px">تسوّق الآن</div>
                        {% for category in footer_categories %}
                        <a href="{{ category.href }}" class="text-2 text-5 poppins-semi-bold-white-14px">{{ category.name }}</a>
                        {% else %}
                        <a href="#" class="text-2 text-5 poppins-semi-bold-white-14px">ملابس رجالية</a>
                        <a href="#" class="text-2 text-5 poppins-semi-bold-white-14px">ملابس نسائية</a>
                        <a href="#" class="text-2 text-5 poppins-semi-bold-white-14px">إكسسوارات</a>
                        <a href="{{ special }}" class="text-2 text-5 poppins-semi-bold-white-14px">تخفيضات</a>
                        {% endfor %}
                    </div>
                </div>
                
                <div class="menu-item">
                    <div class="menu">
                        <div class="text-6 text-5 poppins-bold-white-18px">تواصل معنا</div>
                        {% for information in footer_contact %}
                        <a href="{{ information.href }}" class="text-4 text-5 poppins-semi-bold-white-14px">{{ information.title }}</a>
                        {% else %}
                        <a href="{{ contact }}" class="text-4 text-5 poppins-semi-bold-white-14px">تواصل معنا</a>
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">سياسه الخصوصيه</a>
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">سياسة الاسترجاع</a>
                        {% endfor %}
                    </div>
                </div>
                
                <div class="menu-item">
                    <div class="menu">
                        <div class="text-6 text-5 poppins-bold-white-18px">روابط سريعة</div>
                        <a href="{{ account }}" class="text-4 text-5 poppins-semi-bold-white-14px">حسابي</a>
                        {% for information in informations %}
                        <a href="{{ information.href }}" class="text-4 text-5 poppins-semi-bold-white-14px">{{ information.title }}</a>
                        {% else %}
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">من نحن</a>
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">مساعدة</a>
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">سياسة الخصوصية</a>
                        <a href="#" class="text-4 text-5 poppins-semi-bold-white-14px">شروط الاستخدام</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-71 text-5 poppins-medium-white-14px">{{ powered|default('@2025') }}</div>
    </div>
</footer>

</div><!-- End screen wrapper -->

<!-- Scripts -->
<script src="catalog/view/javascript/jquery/jquery-3.7.1.min.js" type="text/javascript"></script>
<script src="catalog/view/javascript/bootstrap/js/bootstrap.bundle.min.js" type="text/javascript"></script>
<script src="catalog/view/theme/anima/javascript/common.js" type="text/javascript"></script>
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
</body>
</html>
