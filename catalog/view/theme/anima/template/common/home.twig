{{ header }}

<div class="desktop-1 screen">
  
  <!-- Hero Section with Banner -->
  <div class="hero-section">
    {% if banner %}
      <img class="rectangle-5" src="{{ banner }}" alt="{{ name }}">
    {% else %}
      <img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="Hero Banner">
    {% endif %}
    
    <div class="main">
      <h1 class="text-48 text-5">{{ text_shop_now|default('تسوّق الآن') }}</h1>
      <div class="buttons">
        <article class="button-3">
          <a href="{{ view_details }}">
            <div class="button poppins-medium-white-16px">{{ text_view_details|default('عرض التفاصيل') }}</div>
          </a>
        </article>
        <article class="button-4">
          <a href="{{ start_shopping }}">
            <div class="button poppins-semi-bold-white-16px">{{ text_start_shopping|default('ابدأ التسوّق') }}</div>
          </a>
        </article>
      </div>
      <div class="way">
        <div class="rectangle-116"></div>
        <div class="rectangle-116"></div>
        <div class="rectangle-116"></div>
        <div class="rectangle-1162-1"></div>
      </div>
    </div>
  </div>

  <!-- You May Like Section -->
  <div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">
      {{ text_you_may_like|default('منتجات قد تعجبك') }}
    </div>
    
    <div class="cards">
      {% if products_featured %}
        {% for product in products_featured %}
        <article class="card">
          <div class="info-1">
            <div class="image">
              <a href="{{ product.href }}">
                <img src="{{ product.thumb }}" alt="{{ product.name }}">
              </a>
              <button class="wishlist-btn" onclick="wishlist.add('{{ product.product_id }}');">
                <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Add to Wishlist">
              </button>
              {% if product.special %}
              <div class="frame-5 frame">
                <div class="button-1">
                  <div class="button-5 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
                </div>
              </div>
              {% elseif product.new %}
              <div class="frame-5 frame">
                <div class="button-1">
                  <div class="button-5 poppins-medium-white-14px">{{ text_new|default('مجموعة جديدة') }}</div>
                </div>
              </div>
              {% endif %}
            </div>
            <div class="info">
              <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                <a href="{{ product.href }}">{{ product.name }}</a>
              </p>
              <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
              {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
              {% else %}
                {{ product.price }}
              {% endif %}
            </div>
          </div>
          <div class="button-2">
            <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button poppins-semi-bold-white-16px">
              {{ button_cart|default('أضف إلى السلة') }}
            </button>
          </div>
        </article>
        {% endfor %}
      {% else %}
        <!-- Default placeholder cards -->
        {% for i in 1..4 %}
        <article class="card">
          <div class="info-1">
            <div class="image">
              <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
              <div class="frame-5 frame hidden">
                <div class="button-1">
                  <div class="button-5 poppins-medium-white-14px">{{ text_new|default('مجموعة جديدة') }}</div>
                </div>
              </div>
            </div>
            <div class="info">
              <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                T-SHIRT ENERGY - Red and White -
              </p>
              <div class="phone poppins-normal-eerie-black-12px">8001254914589</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">5.000KD</div>
          </div>
          <div class="button-2">
            <div class="button poppins-semi-bold-white-16px">{{ button_cart|default('أضف إلى السلة') }}</div>
          </div>
        </article>
        {% endfor %}
      {% endif %}
    </div>
    
    <div class="way-3">
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-1162"></div>
    </div>
  </div>

  <!-- Navigation Arrows -->
  <div class="arrows">
    <div class="left">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="Previous">
    </div>
    <div class="right">
      <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="Next">
    </div>
  </div>

  <!-- New Arrivals Section -->
  <div class="new-in">
    <div class="new-in-1">
      <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">
        {{ text_new_arrivals|default('وصل حديثًا') }}
      </div>
      
      <!-- Category Tabs -->
      <div class="categories poppins-normal-eerie-black-16px">
        {% if categories %}
          {% for category in categories|slice(0, 3) %}
          <div class="text-5 {% if loop.first %}active{% endif %}" data-category="{{ category.category_id }}">
            {{ category.name }}
          </div>
          {% endfor %}
        {% else %}
          <div class="text-51 text-5">{{ text_accessories|default('إكسسوارات') }}</div>
          <div class="text-52 text-5">{{ text_womens_clothing|default('ملابس نسائية') }}</div>
          <div class="active">{{ text_mens_clothing|default('ملابس رجالية') }}</div>
        {% endif %}
      </div>
    </div>

    <!-- New Arrivals Products -->
    <div class="cards-1">
      {% if products_latest %}
        {% for product in products_latest %}
        <article class="card">
          <div class="info-1">
            <div class="image">
              <a href="{{ product.href }}">
                <img src="{{ product.thumb }}" alt="{{ product.name }}">
              </a>
              <button class="wishlist-btn" onclick="wishlist.add('{{ product.product_id }}');">
                <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
              </button>
              {% if product.special %}
              <div class="frame-5 frame">
                <div class="button-1">
                  <div class="button-5 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
                </div>
              </div>
              {% elseif product.new %}
              <div class="frame-5 frame">
                <div class="button-1">
                  <div class="button-5 poppins-medium-white-14px">{{ text_new|default('جديد') }}</div>
                </div>
              </div>
              {% endif %}
            </div>
            <div class="info">
              <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                <a href="{{ product.href }}">{{ product.name }}</a>
              </p>
              <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
              {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
              {% else %}
                {{ product.price }}
              {% endif %}
            </div>
          </div>
          <div class="button-2">
            <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button poppins-semi-bold-white-16px">
              {{ button_cart|default('أضف إلى السلة') }}
            </button>
          </div>
        </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>

</div>

{{ footer }}
