{{ header }}

<!-- Info Bar -->
<div class="info-2">
    <div class="info-item">
        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2-1.svg" alt="الاسترجاع و التبديل" />
        <div class="info-3">
            <div class="text-3 text-5 poppins-semi-bold-white-16px">الاسترجاع و التبديل</div>
            <p class="text poppins-normal-white-12px">إمكانيه الأسترجاع في حال كان القياس غير مناسب</p>
        </div>
    </div>
    <div class="x2">
        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-time-circle.svg" alt="توصيل خلال ٢٤ ساعة" />
        <div class="info-4">
            <div class="text-3 text-5 poppins-semi-bold-white-16px">توصيل خلال ٢٤ ساعة</div>
            <p class="text poppins-normal-white-12px">توصيل محلي لجميع مناطق الكويت خلال ٢٤ ساعه فقط ١ دينار كويتي من العبدلي الى الخيران</p>
        </div>
    </div>
    <div class="info-item">
        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="منتجات أصلية 100%" />
        <div class="info">
            <div class="text-41 text-5 poppins-semi-bold-white-16px">منتجات أصلية 100%</div>
            <p class="text-42 text-5 poppins-normal-white-12px">جميع المنتجات الأصلية من المصنع مباشره ملابس رياضية - أكسسوارات لتمارين</p>
        </div>
    </div>
</div>

<!-- Hero Banner -->
{% if banners %}
<div class="hero-banner">
    {% for banner in banners %}
    <img class="rectangle-5" src="{{ banner.image }}" alt="{{ banner.title }}" />
    {% endfor %}
</div>
{% else %}
<img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="Hero Banner" />
{% endif %}

<!-- Main CTA -->
<div class="main">
    <h1 class="text-48 text-5">تسوّق الآن</h1>
    <div class="buttons">
        <article class="button-3">
            <a href="{{ special }}" class="button poppins-medium-white-16px">عرض التفاصيل</a>
        </article>
        <article class="button-4">
            <a href="{{ categories[0].href|default('#') }}" class="button poppins-semi-bold-white-16px">ابدأ التسوّق</a>
        </article>
    </div>
    <div class="way">
        <div class="rectangle-116"></div>
        <div class="rectangle-116"></div>
        <div class="rectangle-116"></div>
        <div class="rectangle-1162-1"></div>
    </div>
</div>

<!-- Content Top -->
{{ content_top }}

<!-- New Arrivals Section -->
<div class="new-in">
    <div class="new-in-1">
        <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">وصل حديثًا</div>
        <div class="categories poppins-normal-eerie-black-16px">
            {% for category in categories[:3] %}
            <div class="{{ loop.first ? 'active' : '' }}">
                <a href="{{ category.href }}" class="text-5{{ loop.first ? ' poppins-semi-bold-eerie-black-16px' : '' }}">{{ category.name }}</a>
                {% if loop.first %}<img class="line-1" src="catalog/view/theme/anima/image/line-1-1.svg" alt="" />{% endif %}
            </div>
            {% else %}
            <div class="text-51 text-5">إكسسوارات</div>
            <div class="text-52 text-5">ملابس نسائية</div>
            <div class="active">
                <div class="text-53 text-5 poppins-semi-bold-eerie-black-16px">ملابس رجالية</div>
                <img class="line-1" src="catalog/view/theme/anima/image/line-1-1.svg" alt="" />
            </div>
            {% endfor %}
        </div>
    </div>
    
    <div class="cards">
        {% for product in latest_products %}
        <article class="card">
            <div class="info-1">
                <div class="image" style="background-image: url('{{ product.thumb }}');">
                    <img class="iconly-sharp wishlist-btn" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" data-product-id="{{ product.product_id }}" />
                    {% if product.special %}
                    <div class="frame-5-1">
                        <div class="button-1"><div class="button-9 poppins-medium-white-14px">تخفيض</div></div>
                    </div>
                    {% elseif loop.index <= 4 %}
                    <div class="frame-5-1">
                        <div class="button-1"><div class="button-9 poppins-medium-white-14px">مجموعة جديدة</div></div>
                    </div>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                    <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                    {% if product.special %}
                    <span class="price-old">{{ product.price }}</span>
                    <span class="price-new">{{ product.special }}</span>
                    {% else %}
                    {{ product.price }}
                    {% endif %}
                </div>
            </div>
            <div class="button-2" onclick="addToCart('{{ product.product_id }}');">
                <div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div>
            </div>
        </article>
        {% else %}
        <!-- Placeholder cards if no products -->
        {% for i in 1..4 %}
        <article class="card">
            <div class="info-1">
                <div class="image">
                    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" />
                    <div class="frame-5-1">
                        <div class="button-1"><div class="button-{{ 8 + i }} poppins-medium-white-14px">مجموعة جديدة</div></div>
                    </div>
                </div>
                <div class="info">
                    <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">T-SHIRT ENERGY - Red and White -</p>
                    <div class="phone poppins-normal-eerie-black-12px">8001254914589</div>
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">5.000KD</div>
            </div>
            <div class="button-2"><div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div></div>
        </article>
        {% endfor %}
        {% endfor %}
    </div>
    
    <div class="way-3">
        <div class="rectangle-116-1"></div>
        <div class="rectangle-116-1"></div>
        <div class="rectangle-116-1"></div>
        <div class="rectangle-1162"></div>
    </div>
    
    <div class="button-1">
        <a href="{{ products_link|default('#') }}" class="button-13 poppins-medium-white-14px">عرض الكل</a>
    </div>
</div>

<div class="arrows-1">
    <div class="left">
        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="Previous" />
    </div>
    <div class="right">
        <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="Next" />
    </div>
</div>

<img class="line-2" src="catalog/view/theme/anima/image/line-2-1.svg" alt="" />

<!-- You May Like Section -->
<div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">منتجات قد تعجبك</div>
    
    <div class="cards">
        {% for product in featured_products %}
        <article class="card">
            <div class="info-1">
                <div class="image" style="background-image: url('{{ product.thumb }}');">
                    <img class="iconly-sharp wishlist-btn" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" data-product-id="{{ product.product_id }}" />
                    {% if product.special %}
                    <div class="frame-5 frame">
                        <div class="button-1"><div class="button-5 poppins-medium-white-14px">تخفيض</div></div>
                    </div>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                    <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                    {% if product.special %}
                    <span class="price-old">{{ product.price }}</span>
                    <span class="price-new">{{ product.special }}</span>
                    {% else %}
                    {{ product.price }}
                    {% endif %}
                </div>
            </div>
            <div class="button-2" onclick="addToCart('{{ product.product_id }}');">
                <div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div>
            </div>
        </article>
        {% else %}
        <!-- Placeholder cards if no products -->
        {% for i in 1..4 %}
        <article class="card">
            <div class="info-1">
                <div class="image">
                    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" />
                    <div class="frame-5 frame hidden">
                        <div class="button-1"><div class="button-{{ 4 + i }} poppins-medium-white-14px">مجموعة جديدة</div></div>
                    </div>
                </div>
                <div class="info">
                    <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">T-SHIRT ENERGY - Red and White -</p>
                    <div class="phone poppins-normal-eerie-black-12px">8001254914589</div>
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">5.000KD</div>
            </div>
            <div class="button-2"><div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div></div>
        </article>
        {% endfor %}
        {% endfor %}
    </div>
    
    <div class="way-3">
        <div class="rectangle-116-1"></div>
        <div class="rectangle-116-1"></div>
        <div class="rectangle-116-1"></div>
        <div class="rectangle-1162"></div>
    </div>
</div>

<div class="arrows">
    <div class="left">
        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="Previous" />
    </div>
    <div class="right">
        <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="Next" />
    </div>
</div>

<!-- Content Bottom -->
{{ content_bottom }}

{{ footer }}
