{{ header }}
<div class="desktop-1 screen" dir="{{ direction }}">
    {% if sale_banner_enabled %}
    <div class="sale">
        <p class="text-43 text-5 poppins-medium-white-16px">{{ sale_banner_text }}</p>
    </div>
    {% endif %}
    
    <div class="info-2">
        <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2-1.svg" alt="{{ text_return }}" />
            <div class="info-3">
                <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_return_exchange }}</div>
                <p class="text poppins-normal-white-12px">{{ text_return_desc }}</p>
            </div>
        </div>
        <div class="x2">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-time-circle.svg" alt="{{ text_delivery }}" />
            <div class="info-4">
                <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_delivery_24h }}</div>
                <p class="text poppins-normal-white-12px">{{ text_delivery_desc }}</p>
            </div>
        </div>
        <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="{{ text_original }}" />
            <div class="info">
                <div class="text-41 text-5 poppins-semi-bold-white-16px">{{ text_original_100 }}</div>
                <p class="text-42 text-5 poppins-normal-white-12px">{{ text_original_desc }}</p>
            </div>
        </div>
    </div>
    
    {% if banners %}
    <div class="banner-slider">
        {% for banner in banners %}
        <div class="banner-slide">
            {% if banner.link %}
            <a href="{{ banner.link }}">
                <img class="rectangle-5" src="{{ banner.image }}" alt="{{ banner.title }}" />
            </a>
            {% else %}
            <img class="rectangle-5" src="{{ banner.image }}" alt="{{ banner.title }}" />
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% else %}
    <img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="{{ text_banner }}" />
    {% endif %}
    
    <div class="main">
        <h1 class="text-48 text-5">{{ text_shop_now }}</h1>
        <div class="buttons">
            <article class="button-3">
                <a href="{{ special }}" class="button poppins-medium-white-16px">{{ text_view_details }}</a>
            </article>
            <article class="button-4">
                <a href="{{ all_products }}" class="button poppins-semi-bold-white-16px">{{ text_start_shopping }}</a>
            </article>
        </div>
        <div class="way">
            <div class="rectangle-116"></div>
            <div class="rectangle-116"></div>
            <div class="rectangle-116"></div>
            <div class="rectangle-1162-1"></div>
        </div>
    </div>
    
    <!-- New Arrivals Section -->
    <div class="new-in">
        <div class="new-in-1">
            <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ heading_latest }}</div>
            <div class="categories poppins-normal-eerie-black-16px">
                {% for category in categories %}
                {% if loop.index == 1 %}
                <div class="active">
                    <a href="{{ category.href }}" class="text-53 text-5 poppins-semi-bold-eerie-black-16px">{{ category.name }}</a>
                    <img class="line-1" src="catalog/view/theme/anima/image/line-1-1.svg" alt="Line" />
                </div>
                {% else %}
                <a href="{{ category.href }}" class="text-51 text-5">{{ category.name }}</a>
                {% endif %}
                {% endfor %}
            </div>
        </div>
        
        <div class="cards">
            {% for product in latest_products %}
            <article class="card">
                <div class="info-1">
                    <div class="image" style="background-image: url('{{ product.thumb }}');">
                        <a href="javascript:void(0);" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-btn">
                            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}" />
                        </a>
                        {% if product.labels %}
                        <div class="frame-5-1">
                            {% for label in product.labels %}
                            <div class="button-1"><div class="button-9 poppins-medium-white-14px">{{ label.text }}</div></div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    <div class="info">
                        <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                        <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                    </div>
                    <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                        {% if product.special %}
                        <span class="price-old">{{ product.original_price }}</span>
                        {% endif %}
                        {{ product.price }}
                    </div>
                </div>
                <div class="button-2" onclick="cart.add('{{ product.product_id }}');">
                    <div class="button poppins-semi-bold-white-16px">{{ button_cart }}</div>
                </div>
            </article>
            {% endfor %}
        </div>
        
        <div class="way-3">
            <div class="rectangle-116-1"></div>
            <div class="rectangle-116-1"></div>
            <div class="rectangle-116-1"></div>
            <div class="rectangle-1162"></div>
        </div>
        
        <a href="{{ latest }}" class="button-1">
            <div class="button-13 poppins-medium-white-14px">{{ button_view_all }}</div>
        </a>
    </div>
    
    <div class="arrows-1">
        <div class="left">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="{{ text_prev }}" />
        </div>
        <div class="right">
            <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="{{ text_next }}" />
        </div>
    </div>
    
    <img class="line-2" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
    
    <!-- You May Like Section -->
    <div class="you-may-like">
        <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ heading_featured }}</div>
        <div class="cards">
            {% for product in featured_products %}
            <article class="card">
                <div class="info-1">
                    <div class="image" style="background-image: url('{{ product.thumb }}');">
                        <a href="javascript:void(0);" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-btn">
                            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}" />
                        </a>
                        {% if product.labels %}
                        <div class="frame-5">
                            {% for label in product.labels %}
                            <div class="button-1"><div class="button-5 poppins-medium-white-14px">{{ label.text }}</div></div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    <div class="info">
                        <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                        <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                    </div>
                    <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                        {% if product.special %}
                        <span class="price-old">{{ product.original_price }}</span>
                        {% endif %}
                        {{ product.price }}
                    </div>
                </div>
                <div class="button-2" onclick="cart.add('{{ product.product_id }}');">
                    <div class="button poppins-semi-bold-white-16px">{{ button_cart }}</div>
                </div>
            </article>
            {% endfor %}
        </div>
        <div class="way-3">
            <div class="rectangle-116-1"></div>
            <div class="rectangle-116-1"></div>
            <div class="rectangle-116-1"></div>
            <div class="rectangle-1162"></div>
        </div>
    </div>
    
    <div class="arrows">
        <div class="left">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="{{ text_prev }}" />
        </div>
        <div class="right">
            <img class="iconly-sharp-arrow-left" src="catalog/view/theme/anima/image/iconly-sharp-arrow---left-1.svg" alt="{{ text_next }}" />
        </div>
    </div>
</div>
{{ footer }}
