<!DOCTYPE html>
<html dir="rtl" lang="{{ language }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
<meta name="og:type" content="website" />
<meta name="twitter:card" content="summary" />
{% if og_image %}
<meta property="og:image" content="{{ og_image }}" />
{% endif %}
<link rel="shortcut icon" type="image/png" href="catalog/view/theme/anima/image/favicon.png" />
<link rel="stylesheet" href="catalog/view/theme/anima/stylesheet/globals.css" />
<link rel="stylesheet" href="catalog/view/theme/anima/stylesheet/styleguide.css" />
<link rel="stylesheet" href="catalog/view/theme/anima/stylesheet/desktop-1.css" />
<link rel="stylesheet" href="catalog/view/theme/anima/stylesheet/custom.css" />
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
</head>
<body style="margin: 0; background: #ffffff">
<input type="hidden" id="anPageName" name="page" value="{{ page_name|default('home') }}" />
<!-- Sale Banner -->
<div class="sale">
    <p class="text-43 text-5 poppins-medium-white-16px">{{ sale_text|default('حصل على خصم 20٪ قبل نهاية نوفمبر!') }}</p>
</div>

<!-- Header -->
<header class="header">
    <div class="menu-1">
        <a href="{{ account }}" title="{{ text_account }}">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-profile.svg" alt="{{ text_account }}" />
        </a>
        <a href="{{ cart }}" title="{{ text_cart }}" class="cart-trigger">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2.svg" alt="{{ text_cart }}" />
            {% if cart_total %}
            <span id="cart-total" class="cart-count">{{ cart_total }}</span>
            {% endif %}
        </a>
        <a href="{{ wishlist }}" title="{{ text_wishlist }}">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ text_wishlist }}" />
            {% if wishlist_total %}
            <span class="wishlist-count">{{ wishlist_total }}</span>
            {% endif %}
        </a>
        <a href="{{ search }}" title="{{ text_search }}" class="search-trigger">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-search-1.svg" alt="{{ text_search }}" />
        </a>
        <div class="frame-6 frame">
            <div class="phone-1 poppins-normal-eerie-black-16px">{{ telephone|default('965-22091914') }}</div>
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-call.svg" alt="Phone" />
        </div>
    </div>
    
    <a href="{{ home }}" class="logo poppins-medium-eerie-black-20px">{{ logo_text|default('LOGO') }}</a>
    
    <nav class="navbar poppins-medium-eerie-black-16px">
        {% for category in categories %}
        <a href="{{ category.href }}" class="navbar-link-text">{{ category.name }}</a>
        {% else %}
        <a href="{{ special }}" class="navbar-link-text">تخفيضات</a>
        <a href="#" class="navbar-link-text">إكسسوارات</a>
        <a href="#" class="navbar-link-text">ملابس نسائية</a>
        <a href="#" class="navbar-link-text">ملابس رجالية</a>
        {% endfor %}
    </nav>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu">
    <div class="mobile-menu-header">
        <a href="{{ home }}" class="logo">{{ logo_text|default('LOGO') }}</a>
        <span class="mobile-menu-close">&times;</span>
    </div>
    <nav class="mobile-menu-nav">
        {% for category in categories %}
        <a href="{{ category.href }}">{{ category.name }}</a>
        {% else %}
        <a href="{{ special }}">تخفيضات</a>
        <a href="#">إكسسوارات</a>
        <a href="#">ملابس نسائية</a>
        <a href="#">ملابس رجالية</a>
        {% endfor %}
        <div class="mobile-menu-divider"></div>
        <a href="{{ account }}">{{ text_account }}</a>
        <a href="{{ wishlist }}">{{ text_wishlist }}</a>
        <a href="{{ cart }}">{{ text_cart }}</a>
    </nav>
</div>

<!-- Search Overlay -->
<div class="search-overlay">
    <span class="search-close">&times;</span>
    <form action="{{ search }}" method="get" class="search-form">
        <input type="text" name="search" class="search-input" placeholder="{{ text_search }}" />
    </form>
</div>

<!-- Mini Cart -->
<div class="mini-cart">
    <div class="mini-cart-header">
        <h3>{{ text_cart }}</h3>
        <span class="mini-cart-close">&times;</span>
    </div>
    <div class="mini-cart-items">
        <!-- Cart items loaded via AJAX -->
    </div>
    <div class="mini-cart-footer">
        <a href="{{ cart }}" class="btn btn-secondary">{{ text_cart }}</a>
        <a href="{{ checkout }}" class="btn btn-primary">{{ text_checkout }}</a>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container"></div>

<div class="{{ page_class|default('desktop-1') }} screen">
