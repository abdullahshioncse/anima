<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{{ title }}</title>
    <base href="{{ base }}" />
    {% if description %}
    <meta name="description" content="{{ description }}" />
    {% endif %}
    {% if keywords %}
    <meta name="keywords" content="{{ keywords }}" />
    {% endif %}
    <meta name="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    {% if icon %}
    <link href="{{ icon }}" rel="icon" />
    {% endif %}
    {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}" />
    {% endfor %}
    {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
    {% endfor %}
    {% for script in scripts.header %}
    <script src="{{ script.href }}" type="text/javascript"></script>
    {% endfor %}
    <!-- Anima Theme CSS -->
    <link rel="stylesheet" type="text/css" href="catalog/view/theme/anima/stylesheet/globals.css" />
    <link rel="stylesheet" type="text/css" href="catalog/view/theme/anima/stylesheet/styleguide.css" />
    <link rel="stylesheet" type="text/css" href="catalog/view/theme/anima/stylesheet/desktop-1.css" />
    <link rel="stylesheet" type="text/css" href="catalog/view/theme/anima/stylesheet/custom.css" />
</head>
<body>
<input type="hidden" id="anPageName" name="page" value="{{ page_name|default('home') }}" />

<!-- Sale Banner -->
{% if sale_banner_enabled|default(true) %}
<div class="sale">
    <p class="text-43 text-5 poppins-medium-white-16px">{{ sale_banner_text|default('حصل على خصم 20٪ قبل نهاية نوفمبر!') }}</p>
</div>
{% endif %}

<!-- Header -->
<header class="header">
    <div class="menu-1">
        <a href="{{ account|default('#') }}">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-profile.svg" alt="{{ text_account|default('Account') }}" />
        </a>
        <a href="{{ cart|default('#') }}" class="cart-link">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2.svg" alt="{{ text_cart|default('Cart') }}" />
            {% if cart_count > 0 %}
            <span class="cart-count">{{ cart_count }}</span>
            {% endif %}
        </a>
        <a href="{{ wishlist|default('#') }}" class="wishlist-link">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ text_wishlist|default('Wishlist') }}" />
            {% if wishlist_count > 0 %}
            <span class="wishlist-count">{{ wishlist_count }}</span>
            {% endif %}
        </a>
        <a href="{{ search|default('#') }}" id="search-toggle">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-search-1.svg" alt="{{ text_search|default('Search') }}" />
        </a>
        <div class="frame-6 frame">
            <div class="phone-1 poppins-normal-eerie-black-16px">{{ telephone|default('965-22091914') }}</div>
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-call.svg" alt="{{ text_phone|default('Phone') }}" />
        </div>
    </div>
    <a href="{{ home|default('/') }}" class="logo poppins-medium-eerie-black-20px">
        {% if logo %}
        <img src="{{ logo }}" alt="{{ name }}" title="{{ name }}" />
        {% else %}
        {{ name|default('LOGO') }}
        {% endif %}
    </a>
    <nav class="navbar poppins-medium-eerie-black-16px">
        {% for category in categories %}
        <a href="{{ category.href }}" class="navbar-link-text">{{ category.name }}</a>
        {% endfor %}
    </nav>
</header>

<!-- Mobile Header (for responsive) -->
<header class="header-mobile">
    <div class="menu-1">
        <div class="menu-2" id="mobile-menu-toggle">
            <img class="line-7" src="catalog/view/theme/anima/image/line-7.svg" alt="Menu" />
            <img class="line" src="catalog/view/theme/anima/image/line-7.svg" alt="" />
            <img class="line" src="catalog/view/theme/anima/image/line-7.svg" alt="" />
        </div>
        <a href="{{ account|default('#') }}">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-profile.svg" alt="{{ text_account|default('Account') }}" />
        </a>
        <a href="{{ cart|default('#') }}" class="cart-link">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2.svg" alt="{{ text_cart|default('Cart') }}" />
            {% if cart_count > 0 %}
            <span class="cart-count">{{ cart_count }}</span>
            {% endif %}
        </a>
        <a href="{{ wishlist|default('#') }}" class="wishlist-link">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ text_wishlist|default('Wishlist') }}" />
        </a>
        <a href="{{ search|default('#') }}" id="search-toggle-mobile">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-search.svg" alt="{{ text_search|default('Search') }}" />
        </a>
    </div>
    <a href="{{ home|default('/') }}" class="logo poppins-medium-eerie-black-20px">
        {% if logo %}
        <img src="{{ logo }}" alt="{{ name }}" title="{{ name }}" />
        {% else %}
        {{ name|default('LOGO') }}
        {% endif %}
    </a>
</header>

<!-- Mobile Navigation Menu -->
<nav class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-content">
        {% for category in categories %}
        <a href="{{ category.href }}" class="mobile-nav-link">{{ category.name }}</a>
        {% endfor %}
    </div>
</nav>

<!-- Search Overlay -->
<div class="search-overlay" id="search-overlay">
    <div class="search-container">
        <form action="{{ search }}" method="get">
            <input type="hidden" name="language" value="{{ lang }}" />
            <input type="text" name="search" id="search-input" placeholder="{{ text_search|default('Search') }}" autocomplete="off" />
            <button type="submit" class="search-btn">
                <img src="catalog/view/theme/anima/image/iconly-sharp-search-1.svg" alt="{{ text_search|default('Search') }}" />
            </button>
        </form>
        <button type="button" class="search-close" id="search-close">&times;</button>
    </div>
</div>

<!-- Alert Messages -->
{% if success %}
<div class="alert alert-success alert-dismissible">{{ success }}</div>
{% endif %}
{% if error_warning %}
<div class="alert alert-danger alert-dismissible">{{ error_warning }}</div>
{% endif %}

<main id="content">
