<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title }}</title>
<base href="{{ base }}">
{% if description %}
<meta name="description" content="{{ description }}">
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}">
{% endif %}

<!-- Stylesheets -->
<link rel="stylesheet" href="catalog/view/theme/anima/stylesheet/anima.css">
{% for style in styles %}
<link rel="stylesheet" href="{{ style.href }}">
{% endfor %}

<!-- Scripts -->
{% for script in scripts %}
<script src="{{ script.href }}" {% if script.position == 'header' %}{% endif %}></script>
{% endfor %}

{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}">
{% endfor %}

{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body>

<!-- Top Info Bar -->
<div class="info-2">
  <div class="info-item">
    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2-1.svg" alt="Return & Exchange">
    <div class="info-3">
      <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_return_exchange|default('الاسترجاع و التبديل') }}</div>
      <p class="text poppins-normal-white-12px">{{ text_return_exchange_desc|default('إمكانيه الأسترجاع في حال كان القياس غير مناسب') }}</p>
    </div>
  </div>
  <div class="x2">
    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-time-circle.svg" alt="24 Hour Delivery">
    <div class="info-4">
      <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_delivery_24h|default('توصيل خلال ٢٤ ساعة') }}</div>
      <p class="text poppins-normal-white-12px">
        {{ text_delivery_desc|default('توصيل محلي لجميع مناطق الكويت خلال ٢٤ ساعه فقط ١ دينار كويتي من العبدلي الى الخيران') }}
      </p>
    </div>
  </div>
  <div class="info-item">
    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="100% Authentic">
    <div class="info">
      <div class="text-41 text-5 poppins-semi-bold-white-16px">{{ text_authentic|default('منتجات أصلية 100%') }}</div>
      <p class="text-42 text-5 poppins-normal-white-12px">
        {{ text_authentic_desc|default('جميع المنتجات الأصلية من المصنع مباشره ملابس رياضية - أكسسوارات لتمارين') }}
      </p>
    </div>
  </div>
</div>

<!-- Sale Banner -->
{% if text_sale_banner %}
<div class="sale">
  <p class="text-43 text-5 poppins-medium-white-16px">{{ text_sale_banner }}</p>
</div>
{% endif %}

<!-- Header -->
<header class="header">
  <div class="menu-1">
    <!-- User Account -->
    <a href="{{ account }}" title="{{ text_account|default('حسابي') }}">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-profile.svg" alt="Profile">
    </a>
    
    <!-- Shopping Cart -->
    <a href="{{ cart }}" title="{{ text_cart|default('سلة التسوق') }}">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2.svg" alt="Cart">
      {% if cart_total > 0 %}
      <span class="cart-badge">{{ cart_total }}</span>
      {% endif %}
    </a>
    
    <!-- Wishlist -->
    <a href="{{ wishlist }}" title="{{ text_wishlist|default('المفضلة') }}">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
    </a>
    
    <!-- Search -->
    <a href="{{ search }}" title="{{ text_search|default('بحث') }}" id="search-toggle">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-search-1.svg" alt="Search">
    </a>
    
    <!-- Phone -->
    <div class="frame-6 frame">
      <div class="phone-1 poppins-normal-eerie-black-16px">{{ telephone|default('965-22091914') }}</div>
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-call.svg" alt="Call">
    </div>
  </div>
  
  <!-- Logo -->
  <div class="logo poppins-medium-eerie-black-20px">
    {% if logo %}
    <a href="{{ home }}">
      <img src="{{ logo }}" title="{{ name }}" alt="{{ name }}">
    </a>
    {% else %}
    <a href="{{ home }}">{{ name }}</a>
    {% endif %}
  </div>
  
  <!-- Main Navigation -->
  <nav class="navbar poppins-medium-eerie-black-16px">
    {% if categories %}
      {% for category in categories %}
      <div class="navbar-link-text">
        <a href="{{ category.href }}">{{ category.name }}</a>
      </div>
      {% endfor %}
    {% else %}
      <div class="navbar-link-text"><a href="#">{{ text_mens_clothing|default('ملابس رجالية') }}</a></div>
      <div class="navbar-link-text"><a href="#">{{ text_womens_clothing|default('ملابس نسائية') }}</a></div>
      <div class="navbar-link-text"><a href="#">{{ text_accessories|default('إكسسوارات') }}</a></div>
      <div class="navbar-link-text"><a href="#">{{ text_sale|default('تخفيضات') }}</a></div>
    {% endif %}
  </nav>
</header>

<!-- Search Bar (Toggle) -->
<div id="search-bar" style="display: none;">
  <div class="container">
    <div class="search-form">
      <input type="text" name="search" placeholder="{{ entry_search|default('ابحث عن منتج...') }}" class="form-control">
      <button type="button" class="btn btn-search">{{ button_search|default('بحث') }}</button>
    </div>
  </div>
</div>
