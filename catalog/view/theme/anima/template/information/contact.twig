{{ header }}

<div class="desktop-4 screen contact-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Page Title -->
  <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <div class="row">
    <!-- Contact Information -->
    <div class="col-sm-4">
      <div class="contact-info">
        <h3 class="poppins-semi-bold-eerie-black-24px">{{ text_contact_info|default('معلومات الاتصال') }}</h3>
        
        {% if store %}
        <div class="info-item">
          <h4 class="poppins-semi-bold-eerie-black-18px">{{ text_store|default('المتجر') }}</h4>
          <p class="poppins-medium-eerie-black-16px">{{ store }}</p>
        </div>
        {% endif %}
        
        {% if address %}
        <div class="info-item">
          <div class="x1">
            <div class="poppins-semi-bold-eerie-black-16px">{{ text_address|default('العنوان') }}</div>
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-location.svg" alt="Location">
          </div>
          <p class="poppins-medium-eerie-black-16px">{{ address }}</p>
        </div>
        {% endif %}
        
        {% if telephone %}
        <div class="info-item">
          <div class="phone-number">
            <div class="address poppins-medium-eerie-black-18px">{{ telephone }}</div>
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-calling.svg" alt="Phone">
          </div>
        </div>
        {% endif %}
        
        {% if email %}
        <div class="info-item">
          <div class="email">
            <div class="infosportakwcom poppins-medium-eerie-black-18px">{{ email }}</div>
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-message.svg" alt="Email">
          </div>
        </div>
        {% endif %}
        
        {% if opencart %}
        <div class="info-item">
          <h4 class="poppins-semi-bold-eerie-black-18px">{{ text_opening|default('ساعات العمل') }}</h4>
          <p class="poppins-medium-eerie-black-16px">{{ opencart }}</p>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Contact Form -->
    <div class="col-sm-8">
      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
        <fieldset>
          <legend class="poppins-semi-bold-eerie-black-24px">{{ text_contact_form|default('نموذج الاتصال') }}</legend>
          
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name|default('الاسم') }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" required>
            </div>
          </div>
          
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-email">{{ entry_email|default('البريد الإلكتروني') }}</label>
            <div class="col-sm-10">
              <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" required>
            </div>
          </div>
          
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-enquiry">{{ entry_enquiry|default('الاستفسار') }}</label>
            <div class="col-sm-10">
              <textarea name="enquiry" rows="10" id="input-enquiry" class="form-control" required>{{ enquiry }}</textarea>
            </div>
          </div>
          
          {{ captcha }}
        </fieldset>
        
        <div class="buttons">
          <div class="pull-right">
            <input class="btn btn-primary poppins-semi-bold-white-16px" type="submit" value="{{ button_submit|default('إرسال') }}">
          </div>
        </div>
      </form>
    </div>
  </div>

</div>

{{ footer }}
