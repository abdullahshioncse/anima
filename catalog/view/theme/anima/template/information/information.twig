{{ header }}

<div class="desktop-4 screen information-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Page Title -->
  <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <!-- Information Content -->
  <div class="information-content poppins-medium-eerie-black-18px">
    {{ description }}
  </div>

  <!-- Continue Button -->
  <div class="buttons clearfix">
    <div class="pull-right">
      <a href="{{ continue }}" class="btn btn-primary poppins-semi-bold-white-16px">{{ button_continue|default('متابعة') }}</a>
    </div>
  </div>

</div>

{{ footer }}
