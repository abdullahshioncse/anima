{{ header }}
<div class="desktop-3 screen" dir="{{ direction }}">
    <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <div class="number-1">
        <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
        <p class="text-174">{{ text_products_found|default('تم العثور على') }} {{ product_total }} {{ text_products|default('منتجًا بخصم') }}</p>
        <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
    </div>
    
    {% if products %}
    <div class="cards">
        {% for product in products %}
        <article class="card">
            <div class="info">
                <div class="image" style="background-image: url('{{ product.thumb }}');">
                    <a href="javascript:void(0);" onclick="wishlist.add('{{ product.product_id }}');">
                        <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}" />
                    </a>
                    {% if product.special %}
                    <div class="frame-5 frame">
                        <div class="button"><div class="button-5 poppins-medium-white-14px label-sale">{{ text_sale|default('تخفيض') }}</div></div>
                    </div>
                    {% endif %}
                </div>
                <div class="info-1 info-3">
                    <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                    <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                    {% if product.special %}
                    <span class="price-old">{{ product.price }}</span>
                    {{ product.special }}
                    {% else %}
                    {{ product.price }}
                    {% endif %}
                </div>
            </div>
            <div class="button-1" onclick="cart.add('{{ product.product_id }}');">
                <div class="button-2 poppins-semi-bold-white-16px">{{ button_cart }}</div>
            </div>
        </article>
        {% endfor %}
    </div>
    
    <!-- Sort Options -->
    <div class="menu-4">
        <div class="menu-item-1">
            <div class="text-1-2 text-1-3 poppins-normal-eerie-black-16px">{{ text_sort|default('فرز حسب') }}</div>
            {% for sort_option in sorts %}
            <div class="frame-20 frame{% if sort_option.value == sort ~ '-' ~ order %} active{% endif %}" data-sort="{{ sort_option.value }}">
                <div class="text-189 poppins-medium-eerie-black-18px">{{ sort_option.text }}</div>
                {% if sort_option.value == sort ~ '-' ~ order %}
                <div class="ellipse-11"></div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    
    <!-- Pagination -->
    {% if pagination %}
    <div class="pages">
        {{ pagination }}
    </div>
    {% endif %}
    
    {% else %}
    <div class="no-products">
        <p class="poppins-medium-eerie-black-18px">{{ text_no_results }}</p>
    </div>
    {% endif %}
</div>

<script type="text/javascript">
// Sort selection
document.querySelectorAll('.frame-20').forEach(function(el) {
    el.addEventListener('click', function() {
        var sortValue = this.getAttribute('data-sort');
        var url = '{{ special_url|default("#") }}';
        var parts = sortValue.split('-');
        url += '&sort=' + parts[0] + '&order=' + parts[1];
        window.location.href = url;
    });
});
</script>

{{ footer }}
