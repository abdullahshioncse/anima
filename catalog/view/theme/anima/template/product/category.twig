{{ header }}

<!-- Category Title -->
<h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

<!-- Product Count -->
<div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="" />
    <p class="text-174">{{ text_product_count|format(pagination.total)|default('تم العثور على ' ~ (products|length) ~ ' منتجًا') }}</p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="" />
</div>

<!-- Content Top -->
{{ content_top }}

<!-- Products Grid -->
<div class="cards">
    {% for product in products %}
    <article class="card">
        <div class="info">
            <div class="image" style="background-image: url('{{ product.thumb }}');">
                <img class="iconly-sharp wishlist-btn" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" data-product-id="{{ product.product_id }}" />
                {% if product.special %}
                <div class="frame-5 frame">
                    <div class="button"><div class="button-5 poppins-medium-white-14px">تخفيض</div></div>
                </div>
                {% endif %}
            </div>
            <div class="info-1 info-3">
                <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
                {% else %}
                {{ product.price }}
                {% endif %}
            </div>
        </div>
        <div class="button-1" onclick="addToCart('{{ product.product_id }}');">
            <div class="button-2 poppins-semi-bold-white-16px">أضف إلى السلة</div>
        </div>
    </article>
    {% else %}
    <div class="no-products">
        <p>{{ text_empty }}</p>
        <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
    </div>
    {% endfor %}
</div>

<!-- Filters Sidebar -->
<div class="menu-4">
    <!-- Categories Filter -->
    {% if categories %}
    <div class="menu-item-1">
        <div class="text-1-2 text-1-3 poppins-normal-eerie-black-16px">الفئات</div>
        {% for category in categories %}
        <a href="{{ category.href }}" class="text-1 poppins-medium-eerie-black-18px{% if category.category_id == category_id %} active{% endif %}">{{ category.name }}</a>
        {% endfor %}
    </div>
    <img class="line-3" src="catalog/view/theme/anima/image/line-2-5.svg" alt="" />
    {% endif %}
    
    <!-- Size Filter -->
    <div class="menu-item-1">
        <div class="text-1-2 text-1-3 poppins-normal-eerie-black-16px">المقاس</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">XS</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">S</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">M</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">L</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">XL</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">XXL</div>
        <div class="menu-item-1-item poppins-medium-eerie-black-18px">XXXL</div>
    </div>
    <img class="line-3" src="catalog/view/theme/anima/image/line-2-5.svg" alt="" />
    
    <!-- Color Filter -->
    <div class="menu-item-1">
        <div class="text-1-2 text-1-3 poppins-normal-eerie-black-16px">اللون</div>
        <div class="text-1 poppins-medium-eerie-black-18px">أحمر</div>
        <div class="text-1 poppins-medium-eerie-black-18px">أسود</div>
        <div class="text-1 poppins-medium-eerie-black-18px">أبيض</div>
        <div class="text-1 poppins-medium-eerie-black-18px">أزرق</div>
        <div class="text-1 poppins-medium-eerie-black-18px">أخضر</div>
        <div class="text-1 poppins-medium-eerie-black-18px">متعدد الألوان</div>
    </div>
    <img class="line" src="catalog/view/theme/anima/image/line-4-1.svg" alt="" />
    
    <!-- Sort By -->
    <div class="menu-item-1">
        <div class="text-1-2 text-1-3 poppins-normal-eerie-black-16px">فرز حسب</div>
        {% for sort_option in sorts %}
        <a href="{{ sort_option.href }}" class="frame-20 frame{% if sort_option.value == sort ~ '-' ~ order %} active{% endif %}">
            <div class="text-189 poppins-medium-eerie-black-18px">{{ sort_option.text }}</div>
            {% if sort_option.value == sort ~ '-' ~ order %}
            <div class="ellipse-11"></div>
            {% endif %}
        </a>
        {% else %}
        <div class="frame-20 frame">
            <div class="text-189 poppins-medium-eerie-black-18px">الأكثر شيوعًا</div>
            <div class="ellipse-11"></div>
        </div>
        <div class="text-1 poppins-medium-eerie-black-18px">من الأعلى إلى الأقل سعرًا</div>
        <div class="text-1 poppins-medium-eerie-black-18px">من الأقل إلى الأعلى سعرًا</div>
        <div class="text-1 poppins-medium-eerie-black-18px">من الأحدث إلى الأقدم</div>
        <div class="text-1 poppins-medium-eerie-black-18px">من الأقدم إلى الأحدث</div>
        {% endfor %}
    </div>
</div>

<!-- Pagination -->
{% if pagination %}
<div class="pages">
    {{ pagination }}
</div>
{% else %}
<div class="pages">
    <div class="number poppins-normal-eerie-black-16px">3</div>
    <div class="number poppins-normal-eerie-black-16px">2</div>
    <div class="active">
        <div class="number-2 poppins-semi-bold-eerie-black-16px">1</div>
        <img class="line" src="catalog/view/theme/anima/image/line-1-3.svg" alt="" />
    </div>
</div>
{% endif %}

<!-- Content Bottom -->
{{ content_bottom }}

{{ footer }}
