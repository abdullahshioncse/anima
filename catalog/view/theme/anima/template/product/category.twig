{{ header }}

<div class="desktop-3 screen">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Category Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <!-- Category Description -->
  {% if description %}
  <div class="category-description">
    {{ description }}
  </div>
  {% endif %}

  <!-- Product Count -->
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
    <p class="text-174">
      {{ text_found|default('تم العثور على') }} {{ product_total }} {{ text_products|default('منتجًا') }}
    </p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
  </div>

  <!-- Filters and Sorting -->
  <div class="category-toolbar">
    <div class="filters">
      <!-- Sort Dropdown -->
      <div class="sort-by">
        <label for="input-sort">{{ text_sort|default('ترتيب حسب') }}:</label>
        <select id="input-sort" class="form-control" onchange="location = this.value;">
          {% for sort_option in sorts %}
          <option value="{{ sort_option.href }}" {% if sort_option.value == sort %}selected="selected"{% endif %}>{{ sort_option.text }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- Limit Dropdown -->
      <div class="show-limit">
        <label for="input-limit">{{ text_limit|default('عرض') }}:</label>
        <select id="input-limit" class="form-control" onchange="location = this.value;">
          {% for limit_option in limits %}
          <option value="{{ limit_option.href }}" {% if limit_option.value == limit %}selected="selected"{% endif %}>{{ limit_option.text }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- View Toggle (Grid/List) -->
      <div class="view-toggle">
        <button id="grid-view" class="{% if not list_view %}active{% endif %}">
          <img src="catalog/view/theme/anima/image/iconly-sharp-category.svg" alt="Grid">
        </button>
        <button id="list-view" class="{% if list_view %}active{% endif %}">
          <img src="catalog/view/theme/anima/image/iconly-sharp-document.svg" alt="List">
        </button>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  {% if products %}
  <div class="cards" id="products-grid">
    {% for product in products %}
    <article class="card">
      <div class="info">
        <div class="image">
          <a href="{{ product.href }}">
            <img src="{{ product.thumb }}" alt="{{ product.name }}">
          </a>
          <button class="wishlist-btn" onclick="wishlist.add('{{ product.product_id }}');">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
          </button>
          {% if product.special %}
          <div class="frame-5 frame">
            <div class="button">
              <div class="button-5 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
            </div>
          </div>
          {% elseif product.new %}
          <div class="frame-5 frame">
            <div class="button">
              <div class="button-5 poppins-medium-white-14px">{{ text_new|default('جديد') }}</div>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="info-1 info-3">
          <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
            <a href="{{ product.href }}">{{ product.name }}</a>
          </p>
          <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
        </div>
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
          {% if product.special %}
            <span class="price-old">{{ product.price }}</span>
            <span class="price-new">{{ product.special }}</span>
          {% else %}
            {{ product.price }}
          {% endif %}
        </div>
      </div>
      <div class="button-1">
        <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button-2 poppins-semi-bold-white-16px">
          {{ button_cart|default('أضف إلى السلة') }}
        </button>
      </div>
    </article>
    {% endfor %}
  </div>

  <!-- Pagination -->
  {% if pagination %}
  <div class="pagination-wrapper">
    {{ pagination }}
  </div>
  {% endif %}

  {% else %}
  <!-- No Products Message -->
  <div class="no-products">
    <p>{{ text_no_results|default('لا توجد منتجات في هذا القسم') }}</p>
  </div>
  {% endif %}

  <!-- Sub-categories -->
  {% if categories %}
  <div class="subcategories">
    <h2 class="poppins-semi-bold-eerie-black-24px">{{ text_subcategories|default('أقسام فرعية') }}</h2>
    <div class="category-list">
      {% for category in categories %}
      <div class="category-item">
        <a href="{{ category.href }}">
          {% if category.thumb %}
          <img src="{{ category.thumb }}" alt="{{ category.name }}">
          {% endif %}
          <span>{{ category.name }}</span>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>

<script>
// Grid/List view toggle
$('#grid-view').on('click', function() {
  $('#products-grid').removeClass('list-view').addClass('grid-view');
  $(this).addClass('active');
  $('#list-view').removeClass('active');
  localStorage.setItem('display', 'grid');
});

$('#list-view').on('click', function() {
  $('#products-grid').removeClass('grid-view').addClass('list-view');
  $(this).addClass('active');
  $('#grid-view').removeClass('active');
  localStorage.setItem('display', 'list');
});

// Remember view preference
var display = localStorage.getItem('display');
if (display == 'list') {
  $('#list-view').trigger('click');
}
</script>

{{ footer }}
