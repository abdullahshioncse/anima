{{ header }}

<div class="desktop-3 screen search-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Search Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title|default('نتائج البحث') }}</h1>

  <!-- Search Form -->
  <div class="search-form-wrapper">
    <form action="{{ action }}" method="get">
      <div class="search-input-group">
        <input type="text" name="search" value="{{ search }}" placeholder="{{ entry_search|default('ابحث عن منتج...') }}" class="form-control" required>
        <button type="submit" class="btn btn-search">{{ button_search|default('بحث') }}</button>
      </div>
      
      <div class="search-options">
        <div class="checkbox">
          <label>
            <input type="checkbox" name="description" value="1" {% if description %}checked="checked"{% endif %}>
            {{ text_description|default('البحث في الوصف') }}
          </label>
        </div>
        
        {% if categories %}
        <div class="form-group">
          <label for="input-category">{{ text_category|default('القسم') }}:</label>
          <select name="category_id" id="input-category" class="form-control">
            <option value="0">{{ text_all_categories|default('جميع الأقسام') }}</option>
            {% for category in categories %}
            <option value="{{ category.category_id }}" {% if category.category_id == category_id %}selected="selected"{% endif %}>{{ category.name }}</option>
            {% endfor %}
          </select>
        </div>
        
        <div class="checkbox">
          <label>
            <input type="checkbox" name="sub_category" value="1" {% if sub_category %}checked="checked"{% endif %}>
            {{ text_sub_category|default('البحث في الأقسام الفرعية') }}
          </label>
        </div>
        {% endif %}
      </div>
    </form>
  </div>

  <!-- Product Count -->
  {% if products %}
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
    <p class="text-174">
      {{ text_found|default('تم العثور على') }} {{ product_total }} {{ text_products|default('منتجًا') }}
    </p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
  </div>

  <!-- Filters and Sorting -->
  <div class="category-toolbar">
    <div class="filters">
      <!-- Sort Dropdown -->
      <div class="sort-by">
        <label for="input-sort">{{ text_sort|default('ترتيب حسب') }}:</label>
        <select id="input-sort" class="form-control" onchange="location = this.value;">
          {% for sort_option in sorts %}
          <option value="{{ sort_option.href }}" {% if sort_option.value == sort %}selected{% endif %}>{{ sort_option.text }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- Limit Dropdown -->
      <div class="show-limit">
        <label for="input-limit">{{ text_limit|default('عرض') }}:</label>
        <select id="input-limit" class="form-control" onchange="location = this.value;">
          {% for limit_option in limits %}
          <option value="{{ limit_option.href }}" {% if limit_option.value == limit %}selected{% endif %}>{{ limit_option.text }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="cards" id="products-grid">
    {% for product in products %}
    <article class="card">
      <div class="info">
        <div class="image">
          <a href="{{ product.href }}">
            <img src="{{ product.thumb }}" alt="{{ product.name }}">
          </a>
          <button class="wishlist-btn" onclick="wishlist.add('{{ product.product_id }}');">
            <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
          </button>
          {% if product.special %}
          <div class="frame-5 frame">
            <div class="button">
              <div class="button-5 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="info-1 info-3">
          <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
            <a href="{{ product.href }}">{{ product.name }}</a>
          </p>
          <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
        </div>
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
          {% if product.special %}
            <span class="price-old">{{ product.price }}</span>
            <span class="price-new">{{ product.special }}</span>
          {% else %}
            {{ product.price }}
          {% endif %}
        </div>
      </div>
      <div class="button-1">
        <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button-2 poppins-semi-bold-white-16px">
          {{ button_cart|default('أضف إلى السلة') }}
        </button>
      </div>
    </article>
    {% endfor %}
  </div>

  <!-- Pagination -->
  {% if pagination %}
  <div class="pagination-wrapper">
    {{ pagination }}
  </div>
  {% endif %}

  {% else %}
  <!-- No Results Message -->
  <div class="no-products">
    <p>{{ text_no_results|default('لم يتم العثور على أي منتجات تطابق معايير البحث') }}</p>
  </div>
  {% endif %}

</div>

{{ footer }}
