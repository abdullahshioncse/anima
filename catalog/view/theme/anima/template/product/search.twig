{{ header }}

<!-- Search Title -->
<h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

<!-- Search Form -->
<div class="search-box">
    <form action="{{ action }}" method="get" id="search-form">
        <input type="hidden" name="route" value="product/search" />
        <div class="email-1">
            <button type="submit" class="button-14">
                <span class="button-15 poppins-semi-bold-white-14px">{{ button_search }}</span>
            </button>
            <input type="text" name="search" value="{{ search }}" class="text-55 text-5 poppins-medium-eerie-black-16px" placeholder="{{ entry_search }}" />
        </div>
        
        <div class="search-options">
            <label class="poppins-medium-eerie-black-16px">
                <input type="checkbox" name="description" value="1" {% if description %}checked{% endif %} />
                {{ entry_description }}
            </label>
            
            {% if categories %}
            <select name="category_id" class="form-control">
                <option value="0">{{ text_category }}</option>
                {% for category in categories %}
                <option value="{{ category.category_id }}" {% if category.category_id == category_id %}selected{% endif %}>{{ category.name }}</option>
                {% endfor %}
            </select>
            
            <label class="poppins-medium-eerie-black-16px">
                <input type="checkbox" name="sub_category" value="1" {% if sub_category %}checked{% endif %} />
                {{ entry_sub_category }}
            </label>
            {% endif %}
        </div>
    </form>
</div>

<!-- Product Count -->
{% if products %}
<div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="" />
    <p class="text-174">{{ text_search|format(search) }}</p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="" />
</div>
{% endif %}

{{ content_top }}

<!-- Products Grid -->
{% if products %}
<div class="cards">
    {% for product in products %}
    <article class="card">
        <div class="info">
            <div class="image" style="background-image: url('{{ product.thumb }}');">
                <img class="iconly-sharp wishlist-btn" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" data-product-id="{{ product.product_id }}" />
                {% if product.special %}
                <div class="frame-5 frame">
                    <div class="button"><div class="button-5 poppins-medium-white-14px">تخفيض</div></div>
                </div>
                {% endif %}
            </div>
            <div class="info-1 info-3">
                <a href="{{ product.href }}" class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">{{ product.name }}</a>
                <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
                {% else %}
                {{ product.price }}
                {% endif %}
            </div>
        </div>
        <div class="button-1" onclick="addToCart('{{ product.product_id }}');">
            <div class="button-2 poppins-semi-bold-white-16px">أضف إلى السلة</div>
        </div>
    </article>
    {% endfor %}
</div>

<!-- Pagination -->
{% if pagination %}
<div class="pages">
    {{ pagination }}
</div>
{% endif %}

{% else %}
<div class="no-products text-center">
    <p class="poppins-medium-eerie-black-18px">{{ text_empty }}</p>
</div>
{% endif %}

{{ content_bottom }}

{{ footer }}
