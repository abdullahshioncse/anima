{{ header }}

<div class="desktop-3 screen account-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Page Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <!-- Account Content -->
  <div class="account-content">
    <div class="row">
      <!-- Left Sidebar -->
      <div class="col-sm-3">
        <div class="account-menu">
          <h3 class="poppins-semi-bold-eerie-black-18px">{{ text_my_account|default('حسابي') }}</h3>
          <ul class="list-unstyled">
            <li><a href="{{ edit }}">{{ text_edit|default('تعديل الحساب') }}</a></li>
            <li><a href="{{ password }}">{{ text_password|default('تغيير كلمة المرور') }}</a></li>
            <li><a href="{{ address }}">{{ text_address|default('دفتر العناوين') }}</a></li>
            <li><a href="{{ wishlist }}">{{ text_wishlist|default('قائمة الأمنيات') }}</a></li>
          </ul>
          
          <h3 class="poppins-semi-bold-eerie-black-18px">{{ text_my_orders|default('طلباتي') }}</h3>
          <ul class="list-unstyled">
            <li><a href="{{ order }}">{{ text_order|default('تاريخ الطلبات') }}</a></li>
            <li><a href="{{ download }}">{{ text_download|default('التحميلات') }}</a></li>
            {% if reward %}
            <li><a href="{{ reward }}">{{ text_reward|default('نقاط المكافأة') }}</a></li>
            {% endif %}
            <li><a href="{{ return }}">{{ text_return|default('المرتجعات') }}</a></li>
            <li><a href="{{ transaction }}">{{ text_transaction|default('المعاملات') }}</a></li>
          </ul>
          
          <h3 class="poppins-semi-bold-eerie-black-18px">{{ text_my_newsletter|default('النشرة الإخبارية') }}</h3>
          <ul class="list-unstyled">
            <li><a href="{{ newsletter }}">{{ text_newsletter|default('الاشتراك / إلغاء الاشتراك') }}</a></li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-sm-9">
        {{ content }}
      </div>
    </div>
  </div>

</div>

{{ footer }}
