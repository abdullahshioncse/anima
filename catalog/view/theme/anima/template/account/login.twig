{{ header }}
<div class="desktop-4 screen" dir="{{ direction }}">
    <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    {% if error_warning %}
    <div class="alert alert-danger">{{ error_warning }}</div>
    {% endif %}
    
    {% if success %}
    <div class="alert alert-success">{{ success }}</div>
    {% endif %}
    
    <div class="login-container">
        <div class="login-sections">
            <!-- New Customer Section -->
            <div class="login-section new-customer">
                <h2 class="text-2 poppins-semi-bold-eerie-black-24px">{{ text_new_customer }}</h2>
                <p class="poppins-medium-eerie-black-16px">{{ text_register_account }}</p>
                <a href="{{ register }}" class="button-4">
                    <div class="button poppins-semi-bold-white-16px">{{ button_continue }}</div>
                </a>
            </div>
            
            <!-- Returning Customer Section -->
            <div class="login-section returning-customer">
                <h2 class="text-2 poppins-semi-bold-eerie-black-24px">{{ text_returning_customer }}</h2>
                <p class="poppins-medium-eerie-black-16px">{{ text_i_am_returning_customer }}</p>
                
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-login">
                    <div class="form-group">
                        <label for="input-email" class="poppins-normal-eerie-black-16px">{{ entry_email }}</label>
                        <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_email }}" required />
                        {% if error_email %}
                        <div class="text-danger">{{ error_email }}</div>
                        {% endif %}
                    </div>
                    
                    <div class="form-group">
                        <label for="input-password" class="poppins-normal-eerie-black-16px">{{ entry_password }}</label>
                        <input type="password" name="password" id="input-password" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_password }}" required />
                        {% if error_password %}
                        <div class="text-danger">{{ error_password }}</div>
                        {% endif %}
                    </div>
                    
                    <div class="form-actions">
                        <a href="{{ forgotten }}" class="forgotten-link poppins-medium-eerie-black-14px">{{ text_forgotten }}</a>
                        <button type="submit" class="button-4">
                            <div class="button poppins-semi-bold-white-16px">{{ button_login }}</div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}
