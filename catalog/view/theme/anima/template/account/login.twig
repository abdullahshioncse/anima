{{ header }}

<div class="desktop-3 screen login-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Page Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <div class="row">
    <!-- Returning Customer -->
    <div class="col-sm-6">
      <div class="well">
        <h2 class="poppins-semi-bold-eerie-black-24px">{{ text_returning_customer|default('عميل مسجل') }}</h2>
        <p class="poppins-normal-eerie-black-16px"><strong>{{ text_i_am_returning_customer|default('أنا عميل مسجل') }}</strong></p>
        
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label class="control-label" for="input-email">{{ entry_email|default('البريد الإلكتروني') }}</label>
            <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" required>
          </div>
          
          <div class="form-group">
            <label class="control-label" for="input-password">{{ entry_password|default('كلمة المرور') }}</label>
            <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" required>
            <a href="{{ forgotten }}" class="poppins-normal-eerie-black-14px">{{ text_forgotten|default('نسيت كلمة المرور؟') }}</a>
          </div>
          
          <input type="submit" value="{{ button_login|default('تسجيل الدخول') }}" class="btn btn-primary poppins-semi-bold-white-16px">
          
          {% if redirect %}
          <input type="hidden" name="redirect" value="{{ redirect }}">
          {% endif %}
        </form>
      </div>
    </div>

    <!-- New Customer -->
    <div class="col-sm-6">
      <div class="well">
        <h2 class="poppins-semi-bold-eerie-black-24px">{{ text_new_customer|default('عميل جديد') }}</h2>
        <p class="poppins-normal-eerie-black-16px"><strong>{{ text_register|default('إنشاء حساب') }}</strong></p>
        <p class="poppins-normal-eerie-black-14px">{{ text_register_account|default('بإنشاء حساب ستتمكن من التسوق بشكل أسرع، ومتابعة حالة الطلب، وتتبع الطلبات التي قمت بها مسبقًا.') }}</p>
        <a href="{{ register }}" class="btn btn-primary poppins-semi-bold-white-16px">{{ button_continue|default('متابعة') }}</a>
      </div>
    </div>
  </div>

</div>

{{ footer }}
