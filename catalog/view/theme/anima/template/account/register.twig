{{ header }}
<div class="desktop-4 screen" dir="{{ direction }}">
    <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    {% if error_warning %}
    <div class="alert alert-danger">{{ error_warning }}</div>
    {% endif %}
    
    <div class="register-container">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-register">
            <!-- Personal Details -->
            <fieldset class="register-section">
                <legend class="text-2 poppins-semi-bold-eerie-black-24px">{{ text_your_details }}</legend>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="input-firstname" class="poppins-normal-eerie-black-16px">{{ entry_firstname }}</label>
                        <input type="text" name="firstname" value="{{ firstname }}" id="input-firstname" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_firstname }}" required />
                        {% if error_firstname %}
                        <div class="text-danger">{{ error_firstname }}</div>
                        {% endif %}
                    </div>
                    
                    <div class="form-group">
                        <label for="input-lastname" class="poppins-normal-eerie-black-16px">{{ entry_lastname }}</label>
                        <input type="text" name="lastname" value="{{ lastname }}" id="input-lastname" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_lastname }}" required />
                        {% if error_lastname %}
                        <div class="text-danger">{{ error_lastname }}</div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="input-email" class="poppins-normal-eerie-black-16px">{{ entry_email }}</label>
                    <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_email }}" required />
                    {% if error_email %}
                    <div class="text-danger">{{ error_email }}</div>
                    {% endif %}
                </div>
                
                <div class="form-group">
                    <label for="input-telephone" class="poppins-normal-eerie-black-16px">{{ entry_telephone }}</label>
                    <input type="tel" name="telephone" value="{{ telephone }}" id="input-telephone" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_telephone }}" />
                    {% if error_telephone %}
                    <div class="text-danger">{{ error_telephone }}</div>
                    {% endif %}
                </div>
            </fieldset>
            
            <!-- Password -->
            <fieldset class="register-section">
                <legend class="text-2 poppins-semi-bold-eerie-black-24px">{{ text_your_password }}</legend>
                
                <div class="form-group">
                    <label for="input-password" class="poppins-normal-eerie-black-16px">{{ entry_password }}</label>
                    <input type="password" name="password" id="input-password" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_password }}" required />
                    {% if error_password %}
                    <div class="text-danger">{{ error_password }}</div>
                    {% endif %}
                </div>
                
                <div class="form-group">
                    <label for="input-confirm" class="poppins-normal-eerie-black-16px">{{ entry_confirm }}</label>
                    <input type="password" name="confirm" id="input-confirm" class="form-control poppins-medium-eerie-black-16px" placeholder="{{ entry_confirm }}" required />
                    {% if error_confirm %}
                    <div class="text-danger">{{ error_confirm }}</div>
                    {% endif %}
                </div>
            </fieldset>
            
            <!-- Newsletter -->
            <fieldset class="register-section">
                <legend class="text-2 poppins-semi-bold-eerie-black-24px">{{ text_newsletter }}</legend>
                
                <div class="form-group">
                    <label class="poppins-normal-eerie-black-16px">{{ entry_newsletter }}</label>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" name="newsletter" value="1"{% if newsletter == 1 %} checked{% endif %} />
                            <span class="poppins-medium-eerie-black-16px">{{ text_yes }}</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="newsletter" value="0"{% if newsletter == 0 %} checked{% endif %} />
                            <span class="poppins-medium-eerie-black-16px">{{ text_no }}</span>
                        </label>
                    </div>
                </div>
            </fieldset>
            
            <!-- Privacy Policy -->
            {% if text_agree %}
            <div class="form-group agree-section">
                <label class="checkbox-option">
                    <input type="checkbox" name="agree" value="1" required />
                    <span class="poppins-medium-eerie-black-14px">{{ text_agree }}</span>
                </label>
            </div>
            {% endif %}
            
            <!-- Submit -->
            <div class="form-actions">
                <a href="{{ back }}" class="button-3">
                    <div class="button poppins-medium-white-16px">{{ button_back }}</div>
                </a>
                <button type="submit" class="button-4">
                    <div class="button poppins-semi-bold-white-16px">{{ button_continue }}</div>
                </button>
            </div>
        </form>
    </div>
</div>
{{ footer }}
