{{ header }}

<div class="desktop-3 screen register-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Page Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

  <p class="poppins-normal-eerie-black-16px">{{ text_account_already|default('إذا كان لديك حساب بالفعل، يرجى تسجيل الدخول من') }} <a href="{{ login }}">{{ text_login|default('صفحة تسجيل الدخول') }}</a>.</p>

  <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
    <fieldset>
      <legend class="poppins-semi-bold-eerie-black-24px">{{ text_your_details|default('بياناتك الشخصية') }}</legend>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-firstname">{{ entry_firstname|default('الاسم الأول') }}</label>
        <div class="col-sm-10">
          <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" required>
        </div>
      </div>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-lastname">{{ entry_lastname|default('اسم العائلة') }}</label>
        <div class="col-sm-10">
          <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" required>
        </div>
      </div>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-email">{{ entry_email|default('البريد الإلكتروني') }}</label>
        <div class="col-sm-10">
          <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" required>
        </div>
      </div>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-telephone">{{ entry_telephone|default('رقم الهاتف') }}</label>
        <div class="col-sm-10">
          <input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" required>
        </div>
      </div>
    </fieldset>
    
    <fieldset>
      <legend class="poppins-semi-bold-eerie-black-24px">{{ text_your_password|default('كلمة المرور') }}</legend>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-password">{{ entry_password|default('كلمة المرور') }}</label>
        <div class="col-sm-10">
          <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" required>
        </div>
      </div>
      
      <div class="form-group required">
        <label class="col-sm-2 control-label" for="input-confirm">{{ entry_confirm|default('تأكيد كلمة المرور') }}</label>
        <div class="col-sm-10">
          <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" class="form-control" required>
        </div>
      </div>
    </fieldset>
    
    <fieldset>
      <legend class="poppins-semi-bold-eerie-black-24px">{{ text_newsletter|default('النشرة الإخبارية') }}</legend>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_newsletter|default('الاشتراك') }}</label>
        <div class="col-sm-10">
          <label class="radio-inline">
            <input type="radio" name="newsletter" value="1" {% if newsletter %}checked{% endif %}> {{ text_yes|default('نعم') }}
          </label>
          <label class="radio-inline">
            <input type="radio" name="newsletter" value="0" {% if not newsletter %}checked{% endif %}> {{ text_no|default('لا') }}
          </label>
        </div>
      </div>
    </fieldset>
    
    {% if text_agree %}
    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <div class="checkbox">
          <label>
            <input type="checkbox" name="agree" value="1" required> {{ text_agree }}
          </label>
        </div>
      </div>
    </div>
    {% endif %}
    
    <div class="buttons">
      <div class="pull-right">
        <input type="submit" value="{{ button_continue|default('متابعة') }}" class="btn btn-primary poppins-semi-bold-white-16px">
      </div>
    </div>
  </form>

</div>

{{ footer }}
