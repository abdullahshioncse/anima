{{ header }}

<h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

{{ content_top }}

<div class="register-wrapper">
    <p class="poppins-medium-eerie-black-18px">{{ text_account_already }} <a href="{{ login }}">{{ text_login }}</a></p>
    
    <form id="form-register" action="{{ action }}" method="post" data-oc-toggle="ajax">
        <!-- Personal Details -->
        <fieldset>
            <legend class="poppins-semi-bold-eerie-black-24px">{{ text_your_details }}</legend>
            
            <div class="form-group">
                <label for="input-firstname" class="poppins-normal-eerie-black-16px">{{ entry_firstname }}</label>
                <input type="text" name="firstname" value="{{ firstname }}" id="input-firstname" class="form-control" placeholder="{{ entry_firstname }}" required />
            </div>
            
            <div class="form-group">
                <label for="input-lastname" class="poppins-normal-eerie-black-16px">{{ entry_lastname }}</label>
                <input type="text" name="lastname" value="{{ lastname }}" id="input-lastname" class="form-control" placeholder="{{ entry_lastname }}" required />
            </div>
            
            <div class="form-group">
                <label for="input-email" class="poppins-normal-eerie-black-16px">{{ entry_email }}</label>
                <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" placeholder="{{ entry_email }}" required />
            </div>
            
            {% if config_telephone_display %}
            <div class="form-group">
                <label for="input-telephone" class="poppins-normal-eerie-black-16px">{{ entry_telephone }}</label>
                <input type="tel" name="telephone" value="{{ telephone }}" id="input-telephone" class="form-control" placeholder="{{ entry_telephone }}" {% if config_telephone_required %}required{% endif %} />
            </div>
            {% endif %}
        </fieldset>
        
        <!-- Password -->
        <fieldset>
            <legend class="poppins-semi-bold-eerie-black-24px">{{ text_your_password }}</legend>
            
            <div class="form-group">
                <label for="input-password" class="poppins-normal-eerie-black-16px">{{ entry_password }}</label>
                <input type="password" name="password" value="{{ password }}" id="input-password" class="form-control" placeholder="{{ entry_password }}" required />
            </div>
        </fieldset>
        
        <!-- Newsletter -->
        {% if config_newsletter_display %}
        <fieldset>
            <legend class="poppins-semi-bold-eerie-black-24px">{{ text_newsletter }}</legend>
            
            <div class="form-group">
                <label class="poppins-normal-eerie-black-16px">
                    <input type="checkbox" name="newsletter" value="1" {% if newsletter %}checked{% endif %} />
                    {{ entry_newsletter }}
                </label>
            </div>
        </fieldset>
        {% endif %}
        
        <!-- Privacy Policy -->
        {% if config_account_id %}
        <div class="form-group">
            <label class="poppins-normal-eerie-black-16px">
                <input type="checkbox" name="agree" value="1" required />
                {{ text_agree }} <a href="{{ privacy }}" target="_blank"><b>{{ text_agree_link }}</b></a>
            </label>
        </div>
        {% endif %}
        
        <div class="form-actions">
            <button type="submit" class="button-4">
                <span class="button poppins-semi-bold-white-16px">{{ button_continue }}</span>
            </button>
        </div>
    </form>
</div>

{{ content_bottom }}

{{ footer }}
