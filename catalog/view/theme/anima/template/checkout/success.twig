{{ header }}
<div class="desktop-4 screen" dir="{{ direction }}">
    <div class="success-container">
        <div class="success-icon">
            <img src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="{{ heading_title }}" class="success-check" />
        </div>
        
        <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
        
        <div class="success-message poppins-medium-eerie-black-18px">
            {{ text_message }}
        </div>
        
        <div class="success-actions">
            <a href="{{ continue }}" class="button-4">
                <div class="button poppins-semi-bold-white-16px">{{ button_continue }}</div>
            </a>
        </div>
    </div>
</div>
{{ footer }}
