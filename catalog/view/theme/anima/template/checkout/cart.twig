{{ header }}

<div class="desktop-4 screen cart-page">
  
  <!-- Breadcrumb -->
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <!-- Cart Title -->
  <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title|default('سلة التسوق') }}</h1>

  <!-- Cart Content -->
  {% if products or vouchers %}
  <div class="cart-content">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cart">
      
      <!-- Cart Items Table -->
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <th class="text-center poppins-semi-bold-eerie-black-16px">{{ column_image|default('الصورة') }}</th>
              <th class="text-right poppins-semi-bold-eerie-black-16px">{{ column_name|default('المنتج') }}</th>
              <th class="text-right poppins-semi-bold-eerie-black-16px">{{ column_model|default('رقم المنتج') }}</th>
              <th class="text-center poppins-semi-bold-eerie-black-16px">{{ column_quantity|default('الكمية') }}</th>
              <th class="text-right poppins-semi-bold-eerie-black-16px">{{ column_price|default('السعر') }}</th>
              <th class="text-right poppins-semi-bold-eerie-black-16px">{{ column_total|default('الإجمالي') }}</th>
              <th class="text-center poppins-semi-bold-eerie-black-16px">{{ column_action|default('حذف') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for product in products %}
            <tr>
              <td class="text-center">
                {% if product.thumb %}
                <a href="{{ product.href }}">
                  <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="cart-thumb">
                </a>
                {% endif %}
              </td>
              <td class="text-right">
                <a href="{{ product.href }}" class="poppins-medium-eerie-black-16px">{{ product.name }}</a>
                {% if product.option %}
                  {% for option in product.option %}
                  <br>
                  <small class="poppins-normal-eerie-black-12px">{{ option.name }}: {{ option.value }}</small>
                  {% endfor %}
                {% endif %}
                {% if product.reward %}
                <br>
                <small class="poppins-normal-eerie-black-12px">{{ product.reward }}</small>
                {% endif %}
                {% if product.recurring %}
                <br>
                <small class="poppins-normal-eerie-black-12px">{{ text_recurring|default('دفعة متكررة') }}: {{ product.recurring }}</small>
                {% endif %}
              </td>
              <td class="text-right poppins-normal-eerie-black-14px">{{ product.model }}</td>
              <td class="text-center">
                <div class="number cart-quantity">
                  <button type="button" onclick="incrementCartQty('{{ product.cart_id }}')" class="qty-btn">+</button>
                  <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="form-control poppins-medium-eerie-black-16px" onchange="cart.update('{{ product.cart_id }}', this.value);">
                  <button type="button" onclick="decrementCartQty('{{ product.cart_id }}')" class="qty-btn">-</button>
                </div>
              </td>
              <td class="text-right poppins-semi-bold-eerie-black-16px">{{ product.price }}</td>
              <td class="text-right poppins-semi-bold-eerie-black-16px">{{ product.total }}</td>
              <td class="text-center">
                <button type="button" onclick="cart.remove('{{ product.cart_id }}');" title="{{ button_remove|default('حذف') }}" class="btn btn-danger">
                  <img src="catalog/view/theme/anima/image/iconly-sharp-delete.svg" alt="Remove">
                </button>
              </td>
            </tr>
            {% endfor %}
            
            {% for voucher in vouchers %}
            <tr>
              <td class="text-center"></td>
              <td class="text-right poppins-medium-eerie-black-16px">{{ voucher.description }}</td>
              <td class="text-right"></td>
              <td class="text-center">1</td>
              <td class="text-right poppins-semi-bold-eerie-black-16px">{{ voucher.amount }}</td>
              <td class="text-right poppins-semi-bold-eerie-black-16px">{{ voucher.amount }}</td>
              <td class="text-center">
                <button type="button" onclick="voucher.remove('{{ voucher.key }}');" title="{{ button_remove|default('حذف') }}" class="btn btn-danger">
                  <img src="catalog/view/theme/anima/image/iconly-sharp-delete.svg" alt="Remove">
                </button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>

    <!-- Cart Actions & Totals -->
    <div class="cart-actions">
      <div class="cart-left">
        <!-- Coupon Code -->
        <div class="coupon-section">
          <h3 class="poppins-semi-bold-eerie-black-18px">{{ text_coupon|default('كوبون الخصم') }}</h3>
          <div class="input-group">
            <input type="text" name="coupon" value="{{ coupon }}" placeholder="{{ entry_coupon|default('أدخل كوبون الخصم') }}" id="input-coupon" class="form-control">
            <button type="button" id="button-coupon" class="btn btn-primary">{{ button_coupon|default('تطبيق') }}</button>
          </div>
        </div>

        <!-- Voucher -->
        {% if voucher %}
        <div class="voucher-section">
          <h3 class="poppins-semi-bold-eerie-black-18px">{{ text_voucher|default('قسيمة الهدية') }}</h3>
          <div class="input-group">
            <input type="text" name="voucher" value="{{ voucher }}" placeholder="{{ entry_voucher|default('أدخل قسيمة الهدية') }}" id="input-voucher" class="form-control">
            <button type="button" id="button-voucher" class="btn btn-primary">{{ button_voucher|default('تطبيق') }}</button>
          </div>
        </div>
        {% endif %}

        <!-- Continue Shopping -->
        <div class="continue-shopping">
          <a href="{{ continue }}" class="btn btn-default poppins-medium-eerie-black-16px">
            <img src="catalog/view/theme/anima/image/iconly-sharp-arrow---right.svg" alt="Continue">
            {{ button_shopping|default('متابعة التسوق') }}
          </a>
        </div>
      </div>

      <div class="cart-right">
        <!-- Cart Totals -->
        <div class="cart-totals">
          <h3 class="poppins-semi-bold-eerie-black-24px">{{ text_cart_total|default('إجمالي السلة') }}</h3>
          <table class="table">
            {% for total in totals %}
            <tr>
              <td class="text-right poppins-medium-eerie-black-16px"><strong>{{ total.title }}:</strong></td>
              <td class="text-right poppins-semi-bold-eerie-black-18px">{{ total.text }}</td>
            </tr>
            {% endfor %}
          </table>

          <!-- Checkout Button -->
          <div class="checkout-actions">
            <a href="{{ checkout }}" class="btn btn-primary btn-lg btn-block poppins-semi-bold-white-18px">
              {{ button_checkout|default('إتمام الطلب') }}
              <img src="catalog/view/theme/anima/image/iconly-sharp-arrow---left.svg" alt="Checkout">
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  {% else %}
  <!-- Empty Cart Message -->
  <div class="empty-cart">
    <img src="catalog/view/theme/anima/image/iconly-sharp-bag-3.svg" alt="Empty Cart" class="empty-cart-icon">
    <p class="text poppins-medium-eerie-black-18px">{{ text_empty|default('سلة التسوق فارغة!') }}</p>
    <a href="{{ continue }}" class="btn btn-primary poppins-semi-bold-white-16px">{{ button_continue|default('متابعة التسوق') }}</a>
  </div>
  {% endif %}

</div>

<script>
function incrementCartQty(cart_id) {
  var input = $('input[name=\'quantity[' + cart_id + ']\']');
  var quantity = parseInt(input.val()) + 1;
  input.val(quantity);
  cart.update(cart_id, quantity);
}

function decrementCartQty(cart_id) {
  var input = $('input[name=\'quantity[' + cart_id + ']\']');
  var quantity = parseInt(input.val()) - 1;
  if (quantity > 0) {
    input.val(quantity);
    cart.update(cart_id, quantity);
  }
}

// Coupon
$('#button-coupon').on('click', function() {
  $.ajax({
    url: 'index.php?route=extension/total/coupon.coupon',
    type: 'post',
    data: 'coupon=' + encodeURIComponent($('input[name=\'coupon\']').val()),
    dataType: 'json',
    success: function(json) {
      $('.alert').remove();
      
      if (json['error']) {
        $('.breadcrumb').after('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
      }
      
      if (json['success']) {
        $('.breadcrumb').after('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        
        location.reload();
      }
    }
  });
});

// Voucher
$('#button-voucher').on('click', function() {
  $.ajax({
    url: 'index.php?route=extension/total/voucher.voucher',
    type: 'post',
    data: 'voucher=' + encodeURIComponent($('input[name=\'voucher\']').val()),
    dataType: 'json',
    success: function(json) {
      $('.alert').remove();
      
      if (json['error']) {
        $('.breadcrumb').after('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
      }
      
      if (json['success']) {
        $('.breadcrumb').after('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        
        location.reload();
      }
    }
  });
});
</script>

{{ footer }}
