{{ header }}

<div class="information-page screen">
  <div class="container">
    <h1 class="text-217 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <!-- Last Updated Date -->
    <div class="number">
      <img class="line-2 line" src="catalog/view/image/line-2-1.svg" alt="Line 2"/>
      <div class="text-218">آخر تحديث: {{ date }}</div>
      <img class="line" src="catalog/view/image/line-2-1.svg" alt="Line 3"/>
    </div>
    
    <!-- Content -->
    <div class="information-content">
      <div class="text-3">
        {{ description }}
      </div>
    </div>
    
    <!-- Breadcrumb -->
    <div class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% if not loop.last %} / {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{{ footer }}
