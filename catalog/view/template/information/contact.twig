{{ header }}

<div class="contact-page screen">
  <div class="container">
    <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <div class="row">
      <!-- Contact Form -->
      <div class="col-sm-6">
        <div class="contact-form">
          <h3 class="poppins-semi-bold-eerie-black-24px">{{ text_contact }}</h3>
          <form action="{{ action }}" method="post" enctype="multipart/form-data">
            <div class="form-group required">
              <label for="input-name" class="poppins-medium-eerie-black-16px">{{ entry_name }}</label>
              <input type="text" name="name" value="{{ name }}" id="input-name" class="form-control" required/>
            </div>
            
            <div class="form-group required">
              <label for="input-email" class="poppins-medium-eerie-black-16px">{{ entry_email }}</label>
              <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" required/>
            </div>
            
            <div class="form-group required">
              <label for="input-enquiry" class="poppins-medium-eerie-black-16px">{{ entry_enquiry }}</label>
              <textarea name="enquiry" rows="10" id="input-enquiry" class="form-control" required>{{ enquiry }}</textarea>
            </div>
            
            {{ captcha }}
            
            <div class="buttons">
              <button type="submit" class="button-submit poppins-semi-bold-white-16px">{{ button_submit }}</button>
            </div>
          </form>
        </div>
      </div>
      
      <!-- Contact Information -->
      <div class="col-sm-6">
        <div class="contact-info">
          <h3 class="poppins-semi-bold-eerie-black-24px">{{ text_store }}</h3>
          
          <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-location.svg" alt="Location"/>
            <div class="poppins-medium-eerie-black-16px">
              {{ store }}<br/>
              {{ address }}
            </div>
          </div>
          
          {% if telephone %}
          <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-call.svg" alt="Phone"/>
            <div class="poppins-medium-eerie-black-16px">
              {{ text_telephone }}: <a href="tel:{{ telephone }}">{{ telephone }}</a>
            </div>
          </div>
          {% endif %}
          
          {% if fax %}
          <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-document.svg" alt="Fax"/>
            <div class="poppins-medium-eerie-black-16px">
              {{ text_fax }}: {{ fax }}
            </div>
          </div>
          {% endif %}
          
          {% if open %}
          <div class="info-item">
            <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-time-circle.svg" alt="Hours"/>
            <div class="poppins-medium-eerie-black-16px">
              {{ text_open }}<br/>
              {{ open }}
            </div>
          </div>
          {% endif %}
          
          {% if comment %}
          <div class="info-item">
            <div class="poppins-medium-eerie-black-16px">
              {{ comment }}
            </div>
          </div>
          {% endif %}
        </div>
        
        <!-- Map -->
        {% if geocode %}
        <div class="contact-map">
          <div id="map" style="width: 100%; height: 400px;"></div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if geocode %}
<script type="text/javascript">
function initMap() {
  var geocoder = new google.maps.Geocoder();
  geocoder.geocode({ 'address': '{{ geocode|escape('js') }}'}, function(results, status) {
    if (status == 'OK') {
      var map = new google.maps.Map(document.getElementById('map'), {
        zoom: 15,
        center: results[0].geometry.location
      });
      
      var marker = new google.maps.Marker({
        map: map,
        position: results[0].geometry.location
      });
    }
  });
}
</script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap"></script>
{% endif %}

{{ footer }}
