{{ header }}

<div class="desktop-1 screen">
  <!-- Hero Banner -->
  <img class="rectangle-5" src="catalog/view/image/rectangle-5-1.png" alt="Banner"/>
  
  <div class="main">
    <h1 class="text-48 text-5">تسوّق الآن</h1>
    <div class="buttons">
      <article class="button-3">
        <a href="{{ link_products }}">
          <div class="button poppins-medium-white-16px">عرض التفاصيل</div>
        </a>
      </article>
      <article class="button-4">
        <a href="{{ link_products }}">
          <div class="button poppins-semi-bold-white-16px">ابدأ التسوّق</div>
        </a>
      </article>
    </div>
    <div class="way">
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-1162-1"></div>
    </div>
  </div>
  
  <!-- You May Like Section -->
  <div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">منتجات قد تعجبك</div>
    <div class="cards">
      {% for product in products_featured %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}"/>
            </a>
            <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
              <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
            </button>
            {% if product.special %}
            <div class="frame-5 frame">
              <div class="button-1">
                <div class="button-5 poppins-medium-white-14px">تخفيض</div>
              </div>
            </div>
            {% endif %}
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
            {% if product.special %}
              <span class="price-old">{{ product.price }}</span>
              <span class="price-new">{{ product.special }}</span>
            {% else %}
              {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="button-2">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div>
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="way-3">
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-1162"></div>
    </div>
  </div>
  
  <!-- Navigation Arrows -->
  <div class="arrows">
    <div class="left">
      <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-arrow---left.svg" alt="Previous"/>
    </div>
    <div class="right">
      <img class="iconly-sharp-arrow-left" src="catalog/view/image/iconly-sharp-arrow---left-1.svg" alt="Next"/>
    </div>
  </div>
  
  <!-- New Arrivals Section -->
  <div class="new-in">
    <div class="new-in-1">
      <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">وصل حديثًا</div>
      <div class="categories poppins-normal-eerie-black-16px">
        {% for category in categories %}
        <div class="{% if loop.first %}active{% endif %}">
          <a href="{{ category.href }}">
            <div class="text-53 text-5 poppins-semi-bold-eerie-black-16px">{{ category.name }}</div>
          </a>
          {% if loop.first %}
          <img class="line-1" src="catalog/view/image/line-1-1.svg" alt="Line 1"/>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    
    <div class="cards">
      {% for product in products_latest %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}"/>
            </a>
            <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
              <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
            </button>
            {% if product.special %}
            <div class="frame-5-1">
              <div class="button-1">
                <div class="button-9 poppins-medium-white-14px">مجموعة جديدة</div>
              </div>
            </div>
            {% endif %}
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
            {% if product.special %}
              <span class="price-old">{{ product.price }}</span>
              <span class="price-new">{{ product.special }}</span>
            {% else %}
              {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="button-2">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div>
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
    
    <div class="way-3">
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-116-1"></div>
      <div class="rectangle-1162"></div>
    </div>
  </div>
</div>

{{ footer }}
