{{ header }}

<div class="desktop-1 screen">
  <!-- Hero Banner -->
  <img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="Hero Banner" />
  
  <!-- Main Hero Section -->
  <div class="main">
    <h1 class="text-48 text-5">{{ heading_title|default('تسوّق الآن') }}</h1>
    <div class="buttons">
      <article class="button-3">
        <a href="{{ view_details }}" class="button poppins-medium-white-16px">عرض التفاصيل</a>
      </article>
      <article class="button-4">
        <a href="{{ start_shopping }}" class="button poppins-semi-bold-white-16px">ابدأ التسوّق</a>
      </article>
    </div>
    <div class="way">
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-1162-1"></div>
    </div>
  </div>
  
  <!-- Products Section -->
  <div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ text_products|default('منتجات قد تعجبك') }}</div>
    <div class="cards">
      {% for product in products %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.href }}">
              {% if product.thumb %}
              <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" />
              {% endif %}
            </a>
            <button type="button" class="iconly-sharp" onclick="wishlist.add('{{ product.product_id }}');">
              <img src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" />
            </button>
            {% if product.special %}
            <div class="frame-5 frame">
              <div class="button-1">
                <div class="button-5 poppins-medium-white-14px">مجموعة جديدة</div>
              </div>
            </div>
            {% endif %}
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
            {% if product.special %}
            <span class="price-old">{{ product.price }}</span>
            <span class="price-new">{{ product.special }}</span>
            {% else %}
            {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="button-2">
          <button type="button" class="button poppins-semi-bold-white-16px" onclick="cart.add('{{ product.product_id }}');">
            {{ button_cart|default('أضف إلى السلة') }}
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</div>

{{ footer }}
