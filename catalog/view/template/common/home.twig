{{ header }}

<div class="desktop-1 screen">
  <!-- Info Bar - Features Section -->
  <div class="info-2">
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-bag-2-1.svg" alt="Returns & Exchange">
      <div class="info-3">
        <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_returns_exchange|default('الاسترجاع و التبديل') }}</div>
        <p class="text poppins-normal-white-12px">{{ text_returns_desc|default('إمكانيه الأسترجاع في حال كان القياس غير مناسب') }}</p>
      </div>
    </div>
    <div class="x2">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-time-circle.svg" alt="24 Hour Delivery">
      <div class="info-4">
        <div class="text-3 text-5 poppins-semi-bold-white-16px">{{ text_delivery_24h|default('توصيل خلال ٢٤ ساعة') }}</div>
        <p class="text poppins-normal-white-12px">
          {{ text_delivery_desc|default('توصيل محلي لجميع مناطق الكويت خلال ٢٤ ساعه فقط ١ دينار كويتي من العبدلي الى الخيران') }}
        </p>
      </div>
    </div>
    <div class="info-item">
      <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-tick-square.svg" alt="100% Original">
      <div class="info">
        <div class="text-41 text-5 poppins-semi-bold-white-16px">{{ text_original_100|default('منتجات أصلية 100%') }}</div>
        <p class="text-42 text-5 poppins-normal-white-12px">
          {{ text_original_desc|default('جميع المنتجات الأصلية من المصنع مباشره ملابس رياضية - أكسسوارات لتمارين') }}
        </p>
      </div>
    </div>
  </div>
  
  <!-- Hero Section -->
  {% if banner_image %}
    <img class="rectangle-5" src="{{ banner_image }}" alt="{{ text_shop_now }}">
  {% else %}
    <img class="rectangle-5" src="catalog/view/theme/anima/image/rectangle-5-1.png" alt="{{ text_shop_now|default('تسوّق الآن') }}">
  {% endif %}
  
  <div class="main">
    <h1 class="text-48 text-5">{{ text_hero_title|default('تسوّق الآن') }}</h1>
    <div class="buttons">
      <article class="button-3">
        <a href="{{ link_about }}" class="button poppins-medium-white-16px">{{ text_view_details|default('عرض التفاصيل') }}</a>
      </article>
      <article class="button-4">
        <a href="{{ link_shop }}" class="button poppins-semi-bold-white-16px">{{ text_start_shopping|default('ابدأ التسوّق') }}</a>
      </article>
    </div>
    <div class="way">
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-116"></div>
      <div class="rectangle-1162-1"></div>
    </div>
  </div>
  
  <!-- Products Section -->
  <div class="you-may-like">
    <div class="text-1 text-5 poppins-semi-bold-eerie-black-40px">{{ text_you_may_like|default('منتجات قد تعجبك') }}</div>
    <div class="cards">
      {% if products %}
        {% for product in products %}
          <article class="card">
            <div class="info-1">
              <div class="image">
                {% if product.thumb %}
                  <a href="{{ product.href }}">
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}">
                  </a>
                {% endif %}
                
                <!-- Wishlist Button -->
                <button type="button" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-btn">
                  <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}">
                </button>
                
                {% if product.special %}
                  <div class="frame-5 frame">
                    <div class="button-1">
                      <div class="button-5 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
                    </div>
                  </div>
                {% endif %}
              </div>
              
              <div class="info">
                <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                  <a href="{{ product.href }}">{{ product.name }}</a>
                </p>
                {% if product.model %}
                  <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                {% endif %}
              </div>
              
              <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                {% if product.special %}
                  <span class="price-old">{{ product.price }}</span>
                  <span class="price-new">{{ product.special }}</span>
                {% else %}
                  {{ product.price }}
                {% endif %}
              </div>
            </div>
            
            <div class="button-2">
              <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button poppins-semi-bold-white-16px">
                {{ button_cart|default('أضف إلى السلة') }}
              </button>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <!-- Default placeholder products if none provided -->
        {% for i in 1..4 %}
          <article class="card">
            <div class="info-1">
              <div class="image">
                <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
                <div class="frame-5 frame hidden">
                  <div class="button-1"><div class="button-5 poppins-medium-white-14px">مجموعة جديدة</div></div>
                </div>
              </div>
              <div class="info">
                <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                  T-SHIRT ENERGY - Red and White -
                </p>
                <div class="phone poppins-normal-eerie-black-12px">8001254914589</div>
              </div>
              <div class="x5000-kd poppins-semi-bold-eerie-black-16px">5.000KD</div>
            </div>
            <div class="button-2"><div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div></div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{{ footer }}
