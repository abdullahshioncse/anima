<footer class="footer">
  <!-- Newsletter Subscription -->
  <div class="email">
    <p class="text-155 poppins-semi-bold-white-24px">{{ text_newsletter_title|default('هل ترغب في الاشتراك في نشرتنا الإخبارية؟') }}</p>
    <div class="email-1">
      <form action="{{ newsletter }}" method="post" id="newsletter-form">
        <input type="email" name="email" placeholder="{{ text_newsletter_email|default('البريد الإلكتروني') }}" class="text-156 poppins-medium-eerie-black-16px" required>
        <button type="submit" class="button-3">
          <div class="button-4 poppins-semi-bold-white-14px">{{ text_newsletter_submit|default('إرسال') }}</div>
        </button>
      </form>
    </div>
  </div>
  
  <!-- Footer Content -->
  <div class="info-2 info-3">
    <div class="menu-2">
      <!-- Payment Icons -->
      <div class="payment-icons-2">
        <article class="payment-icons"></article>
        <article class="payment-icons"></article>
        <article class="payment-icons-1">
          <img class="visa-logo" src="catalog/view/theme/anima/image/visa-logo-1.svg" alt="Visa">
        </article>
        <article class="payment-icons-1">
          <img class="apple-pay" src="catalog/view/theme/anima/image/applepay-1.svg" alt="Apple Pay">
        </article>
        <article class="payment-icons-1">
          <img class="mastercard" src="catalog/view/theme/anima/image/mastercard-1@2x.png" alt="Mastercard">
        </article>
      </div>
      
      <!-- Footer Menus -->
      <div class="menu-3">
        <!-- Shop Menu -->
        <div class="menu-item">
          <div class="menu">
            <div class="text-157 poppins-bold-white-18px">{{ text_shop_now|default('تسوّق الآن') }}</div>
            {% if categories %}
              {% for category in categories %}
                <a href="{{ category.href }}" class="text-1 poppins-semi-bold-white-14px">{{ category.name }}</a>
              {% endfor %}
            {% else %}
              <a href="#" class="text-1 poppins-semi-bold-white-14px">ملابس رجالية</a>
              <a href="#" class="text-1 poppins-semi-bold-white-14px">ملابس نسائية</a>
              <a href="#" class="text-1 poppins-semi-bold-white-14px">إكسسوارات</a>
              <a href="#" class="text-1 poppins-semi-bold-white-14px">تخفيضات</a>
            {% endif %}
          </div>
        </div>
        
        <!-- Contact Menu -->
        <div class="menu-item">
          <div class="menu">
            <div class="text-16 poppins-bold-white-18px">{{ text_contact|default('تواصل معنا') }}</div>
            <a href="{{ contact }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_contact_us|default('تواصل معنا') }}</a>
            <a href="{{ information_privacy }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_privacy_policy|default('سياسه الخصوصيه') }}</a>
            <a href="{{ information_return }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_return_policy|default('سياسة الاسترجاع') }}</a>
          </div>
        </div>
        
        <!-- Quick Links Menu -->
        <div class="menu-item">
          <div class="menu">
            <div class="text-16 poppins-bold-white-18px">{{ text_quick_links|default('روابط سريعة') }}</div>
            <a href="{{ account }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_account|default('حسابي') }}</a>
            <a href="{{ information_about }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_about_us|default('من نحن') }}</a>
            <a href="{{ information_contact }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_help|default('مساعدة') }}</a>
            <a href="{{ information_privacy }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_privacy|default('سياسة الخصوصية') }}</a>
            <a href="{{ information_terms }}" class="text-1-1 text-1-3 poppins-semi-bold-white-14px">{{ text_terms|default('شروط الاستخدام') }}</a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="text-172 poppins-medium-white-14px">
      {{ powered|default('') }} {{ text_footer|default('© ' ~ 'now'|date('Y')) }}
    </div>
  </div>
</footer>

<!-- Additional Footer Scripts -->
{% for script in scripts %}
  <script src="{{ script }}" type="text/javascript"></script>
{% endfor %}

<script type="text/javascript">
// Search toggle functionality
document.addEventListener('DOMContentLoaded', function() {
  var searchToggle = document.getElementById('search-toggle');
  var searchPopup = document.getElementById('search-popup');
  var searchClose = document.getElementById('search-close');
  
  if (searchToggle && searchPopup) {
    searchToggle.addEventListener('click', function(e) {
      e.preventDefault();
      searchPopup.style.display = 'block';
      document.getElementById('search-input').focus();
    });
  }
  
  if (searchClose && searchPopup) {
    searchClose.addEventListener('click', function() {
      searchPopup.style.display = 'none';
    });
  }
  
  // Close search popup on outside click
  if (searchPopup) {
    searchPopup.addEventListener('click', function(e) {
      if (e.target === searchPopup) {
        searchPopup.style.display = 'none';
      }
    });
  }
  
  // Newsletter form submission
  var newsletterForm = document.getElementById('newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = this.querySelector('input[name="email"]').value;
      
      // Send AJAX request for newsletter subscription
      fetch(this.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'email=' + encodeURIComponent(email)
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(data.success);
          newsletterForm.reset();
        } else if (data.error) {
          alert(data.error);
        }
      })
      .catch(error => {
        console.error('Error:', error);
      });
    });
  }
});
</script>

</body>
</html>
