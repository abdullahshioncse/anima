{{ header }}

<div class="product-detail">
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <div class="product-content">
    <div class="product-images">
      <div class="product-image-main">
        <img src="{{ thumb }}" alt="{{ heading_title }}" />
      </div>
      {% if images %}
      <div class="product-images-additional">
        {% for image in images %}
        <img src="{{ image.thumb }}" alt="{{ heading_title }}" />
        {% endfor %}
      </div>
      {% endif %}
    </div>
    
    <div class="product-info">
      <div class="phone poppins-normal-eerie-black-12px">{{ model }}</div>
      
      {% if price %}
      <div class="product-price">
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ price }}</div>
      </div>
      {% endif %}
      
      <div class="product-description">
        {{ description }}
      </div>
      
      <div id="product">
        <div class="button-1">
          <button type="button" id="button-cart" class="button-3 poppins-semi-bold-white-16px">أضف إلى السلة</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- You May Like Section -->
<div class="you-may-like">
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">منتجات قد تعجبك</h1>
  <div class="cards">
    {% for product in products %}
      {% if loop.index <= 4 %}
      <article class="card">
        <div class="info">
          <div class="image">
            <button type="button" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-icon">
              <img class="iconly-sharp" src="extension/oc_theme_anima/catalog/view/image/iconly-sharp-heart.svg" alt="Iconly/Sharp/Heart" />
            </button>
            {% if product.special %}
            <div class="frame-5 hidden">
              <div class="button"><div class="button-2 poppins-medium-white-14px">مجموعة جديدة</div></div>
            </div>
            {% endif %}
            <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>
          </div>
          <div class="info-1">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
        </div>
        <div class="button-1">
          <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button-3 poppins-semi-bold-white-16px">أضف إلى السلة</button>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
  <div class="way">
    <div class="rectangle-116 rectangle"></div>
    <div class="rectangle-116 rectangle"></div>
    <div class="rectangle-116 rectangle"></div>
    <div class="rectangle-1162 rectangle"></div>
  </div>
</div>

<!-- Arrows -->
<div class="arrows">
  <div class="left">
    <img class="iconly-sharp" src="extension/oc_theme_anima/catalog/view/image/iconly-sharp-arrow---left.svg" alt="Iconly/Sharp/Arrow - Left" />
  </div>
  <div class="right">
    <img class="iconly-sharp-arrow-left" src="extension/oc_theme_anima/catalog/view/image/iconly-sharp-arrow---left-1.svg" alt="Iconly/Sharp/Arrow - Left" />
  </div>
</div>

{{ footer }}
