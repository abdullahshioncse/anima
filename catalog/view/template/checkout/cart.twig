{{ header }}

<div class="shopping-cart screen">
  <div class="container">
    <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    {% if products or vouchers %}
    <form action="{{ update }}" method="post">
      <div class="cart-table">
        <table class="table">
          <thead>
            <tr>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_image }}</th>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_name }}</th>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_model }}</th>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_quantity }}</th>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_price }}</th>
              <th class="poppins-semi-bold-eerie-black-16px">{{ column_total }}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for product in products %}
            <tr>
              <td class="text-center">
                <a href="{{ product.href }}">
                  <img src="{{ product.thumb }}" alt="{{ product.name }}" class="cart-thumb"/>
                </a>
              </td>
              <td class="poppins-medium-eerie-black-14px">
                <a href="{{ product.href }}">{{ product.name }}</a>
                {% if product.option %}
                  <div class="cart-options">
                    {% for option in product.option %}
                    <small>{{ option.name }}: {{ option.value }}</small><br/>
                    {% endfor %}
                  </div>
                {% endif %}
                {% if product.reward %}
                  <small class="reward">{{ product.reward }}</small>
                {% endif %}
                {% if product.recurring %}
                  <small class="recurring">{{ product.recurring }}</small>
                {% endif %}
              </td>
              <td class="poppins-normal-eerie-black-14px">{{ product.model }}</td>
              <td>
                <div class="quantity-control">
                  <button type="button" class="qty-btn minus" onclick="decreaseCartQty('{{ product.cart_id }}')">
                    <img src="catalog/view/image/minus.png" alt="Minus"/>
                  </button>
                  <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" class="qty-input" id="qty-{{ product.cart_id }}"/>
                  <button type="button" class="qty-btn plus" onclick="increaseCartQty('{{ product.cart_id }}')">
                    <img src="catalog/view/image/add.png" alt="Plus"/>
                  </button>
                </div>
              </td>
              <td class="poppins-semi-bold-eerie-black-14px">{{ product.price }}</td>
              <td class="poppins-semi-bold-eerie-black-16px">{{ product.total }}</td>
              <td class="text-center">
                <button type="button" onclick="cart.remove('{{ product.cart_id }}');" class="btn-remove">
                  <img src="catalog/view/image/iconly-sharp-delete.svg" alt="Remove"/>
                </button>
              </td>
            </tr>
            {% endfor %}
            
            {% for voucher in vouchers %}
            <tr>
              <td></td>
              <td class="poppins-medium-eerie-black-14px">{{ voucher.description }}</td>
              <td></td>
              <td class="text-right">1</td>
              <td class="poppins-semi-bold-eerie-black-14px">{{ voucher.amount }}</td>
              <td class="poppins-semi-bold-eerie-black-16px">{{ voucher.amount }}</td>
              <td class="text-center">
                <button type="button" onclick="voucher.remove('{{ voucher.key }}');" class="btn-remove">
                  <img src="catalog/view/image/iconly-sharp-delete.svg" alt="Remove"/>
                </button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      
      <!-- Update Cart Button -->
      <div class="cart-actions">
        <button type="submit" class="button-update poppins-semi-bold-white-16px">
          {{ button_update }}
        </button>
        <a href="{{ continue }}" class="button-continue poppins-medium-eerie-black-16px">
          {{ button_shopping }}
        </a>
      </div>
    </form>
    
    <!-- Cart Totals -->
    <div class="cart-totals">
      <h3 class="poppins-semi-bold-eerie-black-24px">{{ text_next }}</h3>
      <table class="table-totals">
        {% for total in totals %}
        <tr>
          <td class="poppins-medium-eerie-black-16px">{{ total.title }}:</td>
          <td class="poppins-semi-bold-eerie-black-16px text-right">{{ total.text }}</td>
        </tr>
        {% endfor %}
      </table>
      
      <!-- Coupon/Voucher -->
      <div class="cart-promocode">
        <input type="text" name="coupon" placeholder="{{ entry_coupon }}" class="form-control"/>
        <button type="button" id="button-coupon" class="button-apply poppins-semi-bold-white-14px">
          {{ button_coupon }}
        </button>
      </div>
      
      <!-- Checkout Button -->
      <a href="{{ checkout }}" class="button-checkout poppins-semi-bold-white-16px">
        {{ button_checkout }}
      </a>
    </div>
    
    {% else %}
    <div class="empty-cart">
      <p class="poppins-medium-eerie-black-18px">{{ text_empty }}</p>
      <a href="{{ continue }}" class="button-continue poppins-semi-bold-white-16px">
        {{ button_continue }}
      </a>
    </div>
    {% endif %}
  </div>
</div>

<script>
function increaseCartQty(cart_id) {
  var qty = parseInt(document.getElementById('qty-' + cart_id).value);
  document.getElementById('qty-' + cart_id).value = qty + 1;
}

function decreaseCartQty(cart_id) {
  var qty = parseInt(document.getElementById('qty-' + cart_id).value);
  if (qty > 1) {
    document.getElementById('qty-' + cart_id).value = qty - 1;
  }
}
</script>

{{ footer }}
