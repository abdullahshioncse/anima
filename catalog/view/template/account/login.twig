{{ header }}

<div class="account-login screen">
  <div class="container">
    <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <div class="row">
      <!-- Returning Customer -->
      <div class="col-sm-6">
        <div class="card">
          <div class="card-header poppins-semi-bold-eerie-black-24px">
            {{ text_returning_customer }}
          </div>
          <div class="card-body">
            <form action="{{ action }}" method="post" enctype="multipart/form-data">
              <div class="form-group">
                <label for="input-email" class="poppins-medium-eerie-black-16px">{{ entry_email }}</label>
                <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" required/>
              </div>
              <div class="form-group">
                <label for="input-password" class="poppins-medium-eerie-black-16px">{{ entry_password }}</label>
                <input type="password" name="password" value="" placeholder="{{ entry_password }}" id="input-password" class="form-control" required/>
                <a href="{{ forgotten }}" class="poppins-normal-eerie-black-14px">{{ text_forgotten }}</a>
              </div>
              <button type="submit" class="button-login poppins-semi-bold-white-16px">{{ button_login }}</button>
            </form>
          </div>
        </div>
      </div>
      
      <!-- New Customer -->
      <div class="col-sm-6">
        <div class="card">
          <div class="card-header poppins-semi-bold-eerie-black-24px">
            {{ text_new_customer }}
          </div>
          <div class="card-body">
            <p class="poppins-medium-eerie-black-16px">{{ text_register }}</p>
            <p class="poppins-normal-eerie-black-14px">{{ text_register_account }}</p>
            <a href="{{ register }}" class="button-register poppins-semi-bold-white-16px">{{ button_continue }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ footer }}
