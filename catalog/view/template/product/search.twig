{{ header }}

<div class="product-search screen">
  <div class="container">
    <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    <!-- Search Form -->
    <div class="search-form">
      <form action="{{ action }}" method="get">
        <div class="input-group">
          <input type="text" name="search" value="{{ search }}" placeholder="{{ text_keyword }}" class="form-control poppins-medium-eerie-black-16px"/>
          <div class="input-group-append">
            <button type="submit" class="button-search poppins-semi-bold-white-16px">
              <img src="catalog/view/image/iconly-sharp-search-1.svg" alt="Search"/>
              {{ button_search }}
            </button>
          </div>
        </div>
        
        <div class="advanced-search">
          <label class="poppins-medium-eerie-black-14px">
            <input type="checkbox" name="description" value="1" {% if description %}checked{% endif %}/>
            {{ text_search_description }}
          </label>
          
          <label for="input-category" class="poppins-medium-eerie-black-14px">{{ text_category }}</label>
          <select name="category_id" id="input-category" class="form-control">
            <option value="0">{{ text_all_categories }}</option>
            {% for category in categories %}
              <option value="{{ category.category_id }}" {% if category.category_id == category_id %}selected{% endif %}>{{ category.name }}</option>
            {% endfor %}
          </select>
          
          <label class="poppins-medium-eerie-black-14px">
            <input type="checkbox" name="sub_category" value="1" {% if sub_category %}checked{% endif %}/>
            {{ text_sub_category }}
          </label>
        </div>
      </form>
    </div>
    
    <!-- Search Results -->
    {% if products %}
    <div class="search-results">
      <div class="number-1">
        <img class="line-2 line-3" src="catalog/view/image/line-2-1.svg" alt="Line"/>
        <p class="text-174">تم العثور على {{ product_total }} منتجًا</p>
        <img class="line" src="catalog/view/image/line-2-1.svg" alt="Line"/>
      </div>
      
      <div class="cards">
        {% for product in products %}
        <article class="card">
          <div class="info">
            <div class="image">
              <a href="{{ product.href }}">
                <img src="{{ product.thumb }}" alt="{{ product.name }}"/>
              </a>
              <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
                <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
              </button>
              {% if product.special %}
              <div class="frame-5">
                <div class="button">
                  <div class="button-2 poppins-medium-white-14px">تخفيض</div>
                </div>
              </div>
              {% endif %}
            </div>
            <div class="info-1">
              <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                <a href="{{ product.href }}">{{ product.name }}</a>
              </p>
              <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
            </div>
            <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
              {% if product.special %}
                <span class="price-old">{{ product.price }}</span>
                <span class="price-new">{{ product.special }}</span>
              {% else %}
                {{ product.price }}
              {% endif %}
            </div>
          </div>
          <div class="button-1">
            <button type="button" onclick="cart.add('{{ product.product_id }}');">
              <div class="button-3 poppins-semi-bold-white-16px">أضف إلى السلة</div>
            </button>
          </div>
        </article>
        {% endfor %}
      </div>
      
      <!-- Pagination -->
      {% if pagination %}
      <div class="pagination">
        {{ pagination }}
      </div>
      {% endif %}
    </div>
    {% else %}
    <div class="no-results poppins-medium-eerie-black-18px">
      {{ text_empty }}
    </div>
    {% endif %}
  </div>
</div>

{{ footer }}
