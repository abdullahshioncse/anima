{{ header }}

<div class="product-page screen">
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% if not loop.last %} / {% endif %}
    {% endfor %}
  </div>
  
  <div class="product-container">
    <!-- Product Images -->
    <div class="product-images">
      <div class="main-image">
        <img src="{{ thumb }}" alt="{{ heading_title }}" id="product-main-image"/>
      </div>
      {% if images %}
      <div class="thumbnails">
        <img src="{{ thumb }}" alt="{{ heading_title }}" class="thumbnail active" onclick="changeImage('{{ thumb }}')"/>
        {% for image in images %}
        <img src="{{ image.thumb }}" alt="{{ heading_title }}" class="thumbnail" onclick="changeImage('{{ image.popup }}')"/>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    
    <!-- Product Info -->
    <div class="product-info">
      <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
      
      <div class="product-model poppins-normal-eerie-black-12px">
        {{ text_model }}: {{ model }}
      </div>
      
      <!-- Rating -->
      {% if rating %}
      <div class="rating">
        <div class="stars">
          {% for i in 1..5 %}
            {% if i <= rating %}
            <img src="catalog/view/image/star-5.svg" alt="Star"/>
            {% else %}
            <img src="catalog/view/image/star-6.svg" alt="Empty Star"/>
            {% endif %}
          {% endfor %}
        </div>
        <span class="poppins-normal-eerie-black-14px">({{ reviews }} {{ text_reviews }})</span>
      </div>
      {% endif %}
      
      <!-- Price -->
      <div class="product-price">
        {% if special %}
          <div class="price-special poppins-semi-bold-eerie-black-24px">{{ special }}</div>
          <div class="price-old poppins-normal-eerie-black-18px">{{ price }}</div>
        {% else %}
          <div class="price poppins-semi-bold-eerie-black-24px">{{ price }}</div>
        {% endif %}
      </div>
      
      <!-- Description -->
      <div class="product-description poppins-medium-eerie-black-16px">
        {{ description }}
      </div>
      
      <!-- Options -->
      {% if options %}
      <div class="product-options">
        {% for option in options %}
        <div class="option">
          <label class="poppins-semi-bold-eerie-black-16px">{{ option.name }}:</label>
          {% if option.type == 'select' %}
            <select name="option[{{ option.product_option_id }}]" class="form-control">
              <option value="">{{ text_select }}</option>
              {% for option_value in option.product_option_value %}
              <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}</option>
              {% endfor %}
            </select>
          {% elseif option.type == 'radio' %}
            <div class="radio-options">
              {% for option_value in option.product_option_value %}
              <label class="radio-label">
                <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}"/>
                {{ option_value.name }}
              </label>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      
      <!-- Quantity -->
      <div class="quantity-section">
        <label class="poppins-semi-bold-eerie-black-16px">{{ text_qty }}:</label>
        <div class="quantity-control">
          <button type="button" class="qty-btn minus" onclick="decreaseQty()">
            <img src="catalog/view/image/minus.png" alt="Minus"/>
          </button>
          <input type="text" name="quantity" value="{{ minimum }}" id="input-quantity" class="qty-input"/>
          <button type="button" class="qty-btn plus" onclick="increaseQty()">
            <img src="catalog/view/image/add.png" alt="Plus"/>
          </button>
        </div>
      </div>
      
      <!-- Add to Cart Button -->
      <div class="product-actions">
        <button type="button" id="button-cart" class="button-cart poppins-semi-bold-white-16px">
          أضف إلى السلة
        </button>
        <button type="button" onclick="wishlist.add('{{ product_id }}');" class="button-wishlist">
          <img src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
        </button>
      </div>
      
      <!-- Availability -->
      <div class="availability poppins-normal-eerie-black-14px">
        {{ text_stock }}: {{ stock }}
      </div>
    </div>
  </div>
  
  <!-- Related Products -->
  {% if products %}
  <div class="related-products">
    <h2 class="poppins-semi-bold-eerie-black-32px">منتجات ذات صلة</h2>
    <div class="cards">
      {% for product in products %}
      <article class="card">
        <div class="info-1">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}"/>
            </a>
            <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
              <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
            </button>
          </div>
          <div class="info">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
            {% if product.special %}
              <span class="price-old">{{ product.price }}</span>
              <span class="price-new">{{ product.special }}</span>
            {% else %}
              {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="button-2">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button poppins-semi-bold-white-16px">أضف إلى السلة</div>
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>

<script>
function changeImage(src) {
  document.getElementById('product-main-image').src = src;
  document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
  event.target.classList.add('active');
}

function increaseQty() {
  var qty = parseInt(document.getElementById('input-quantity').value);
  document.getElementById('input-quantity').value = qty + 1;
}

function decreaseQty() {
  var qty = parseInt(document.getElementById('input-quantity').value);
  if (qty > 1) {
    document.getElementById('input-quantity').value = qty - 1;
  }
}

document.getElementById('button-cart').addEventListener('click', function() {
  cart.add('{{ product_id }}', document.getElementById('input-quantity').value);
});
</script>

{{ footer }}
