{{ header }}

<div class="product-info">
  <div class="product-images">
    <div class="main-image">
      {% if thumb %}
      <img src="{{ thumb }}" alt="{{ heading_title }}" />
      {% endif %}
    </div>
    {% if images %}
    <div class="additional-images">
      {% for image in images %}
      <img src="{{ image.thumb }}" alt="{{ heading_title }}" />
      {% endfor %}
    </div>
    {% endif %}
  </div>
  
  <div class="product-details">
    <h1 class="poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
    
    {% if manufacturer %}
    <div class="manufacturer poppins-normal-eerie-black-16px">
      {{ text_manufacturer }}: <a href="{{ manufacturers }}">{{ manufacturer }}</a>
    </div>
    {% endif %}
    
    <div class="product-model poppins-normal-eerie-black-12px">
      {{ text_model }}: {{ model }}
    </div>
    
    {% if price %}
    <div class="product-price">
      {% if special %}
      <span class="price-old poppins-normal-eerie-black-16px">{{ price }}</span>
      <span class="price-new poppins-semi-bold-eerie-black-16px">{{ special }}</span>
      {% else %}
      <span class="price poppins-semi-bold-eerie-black-16px">{{ price }}</span>
      {% endif %}
    </div>
    {% endif %}
    
    {% if description %}
    <div class="product-description poppins-medium-eerie-black-18px">
      {{ description }}
    </div>
    {% endif %}
    
    <div id="product">
      {% if options %}
      <div class="product-options">
        {% for option in options %}
        <div class="form-group{% if option.required %} required {% endif %}">
          <label class="control-label poppins-medium-eerie-black-16px">{{ option.name }}</label>
          <select name="option[{{ option.product_option_id }}]" class="form-control">
            <option value="">{{ text_select }}</option>
            {% for option_value in option.product_option_value %}
            <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
            {% if option_value.price %}
            ({{ option_value.price_prefix }}{{ option_value.price }})
            {% endif %}
            </option>
            {% endfor %}
          </select>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      
      <div class="product-quantity">
        <label class="control-label poppins-medium-eerie-black-16px">{{ text_qty }}</label>
        <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control" />
        <input type="hidden" name="product_id" value="{{ product_id }}" />
      </div>
      
      <div class="button-group">
        <button type="button" id="button-cart" data-product-id="{{ product_id }}" class="button-2 poppins-semi-bold-white-16px btn-cart-product">
          أضف إلى السلة
        </button>
        <button type="button" class="wishlist" data-product-id="{{ product_id }}">
          <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist" />
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Related Products -->
{% if products %}
<div class="you-may-like">
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">منتجات قد تعجبك</h1>
  <div class="cards">
    {% for product in products %}
    <article class="card">
      <div class="info">
        <div class="image">
          <a href="{{ product.href }}">
            {% if product.thumb %}
            <img src="{{ product.thumb }}" alt="{{ product.name }}" />
            {% endif %}
          </a>
          <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Iconly/Sharp/Heart" />
        </div>
        <div class="info-1">
          <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
            <a href="{{ product.href }}">{{ product.name }}</a>
          </p>
          <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
        </div>
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">{{ product.price }}</div>
      </div>
      <div class="button-1">
        <div class="button-3 poppins-semi-bold-white-16px">
          <button type="button" data-product-id="{{ product.product_id }}" class="btn-cart">أضف إلى السلة</button>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</div>
{% endif %}

{{ footer }}
