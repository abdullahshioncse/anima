{{ header }}

<div class="desktop-3 screen">
  <!-- Breadcrumb -->
  {% if breadcrumbs %}
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          {% if not loop.last %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          {% else %}
            {{ breadcrumb.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
  
  <div class="product-detail">
    <div class="row">
      <!-- Product Images -->
      <div class="col-md-6">
        <div class="product-images">
          {% if thumb %}
            <div class="product-image-main">
              <img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-fluid">
            </div>
          {% endif %}
          
          {% if images %}
            <div class="product-image-thumbnails">
              {% for image in images %}
                <div class="thumbnail">
                  <img src="{{ image.thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Product Information -->
      <div class="col-md-6">
        <div class="product-info">
          <h1 class="poppins-semi-bold-eerie-black-32px">{{ heading_title }}</h1>
          
          {% if manufacturer %}
            <div class="manufacturer">
              <strong>{{ text_manufacturer }}</strong> <a href="{{ manufacturers }}">{{ manufacturer }}</a>
            </div>
          {% endif %}
          
          {% if model %}
            <div class="model poppins-normal-eerie-black-12px">
              <strong>{{ text_model }}</strong> {{ model }}
            </div>
          {% endif %}
          
          <!-- Price -->
          <div class="product-price">
            {% if special %}
              <div class="price-special">
                <span class="price-old poppins-medium-eerie-black-18px">{{ price }}</span>
                <span class="price-new poppins-semi-bold-eerie-black-24px">{{ special }}</span>
              </div>
            {% else %}
              <span class="price poppins-semi-bold-eerie-black-24px">{{ price }}</span>
            {% endif %}
            
            {% if tax %}
              <div class="price-tax">{{ text_tax }} {{ tax }}</div>
            {% endif %}
            
            {% if points %}
              <div class="reward-points">{{ text_points }} {{ points }}</div>
            {% endif %}
          </div>
          
          <!-- Product Options -->
          {% if options %}
            <div class="product-options">
              {% for option in options %}
                <div class="form-group{% if option.required %} required{% endif %}">
                  <label class="control-label">{{ option.name }}</label>
                  
                  {% if option.type == 'select' %}
                    <select name="option[{{ option.product_option_id }}]" class="form-control">
                      <option value="">{{ text_select }}</option>
                      {% for option_value in option.product_option_value %}
                        <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                        {% if option_value.price %}
                          ({{ option_value.price_prefix }}{{ option_value.price }})
                        {% endif %}
                        </option>
                      {% endfor %}
                    </select>
                  {% endif %}
                  
                  {% if option.type == 'radio' %}
                    <div class="radio-group">
                      {% for option_value in option.product_option_value %}
                        <label class="radio-inline">
                          <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}">
                          {{ option_value.name }}
                          {% if option_value.price %}
                            ({{ option_value.price_prefix }}{{ option_value.price }})
                          {% endif %}
                        </label>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
          
          <!-- Quantity and Add to Cart -->
          <div class="product-actions">
            <div class="quantity-selector">
              <label>{{ text_qty }}</label>
              <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control">
            </div>
            
            <div class="action-buttons">
              <button type="button" id="button-cart" class="button-2 btn btn-primary">
                <div class="button poppins-semi-bold-white-16px">{{ button_cart|default('أضف إلى السلة') }}</div>
              </button>
              
              <button type="button" onclick="wishlist.add('{{ product_id }}');" class="btn btn-secondary">
                <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}">
              </button>
            </div>
          </div>
          
          <!-- Stock Status -->
          {% if stock %}
            <div class="stock-status">
              <strong>{{ text_stock }}</strong> {{ stock }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    
    <!-- Product Description Tabs -->
    <div class="product-tabs">
      <ul class="nav nav-tabs">
        <li class="nav-item">
          <a class="nav-link active" data-bs-toggle="tab" href="#tab-description">{{ tab_description }}</a>
        </li>
        {% if attribute_groups %}
          <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-specification">{{ tab_attribute }}</a>
          </li>
        {% endif %}
        {% if review_status %}
          <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-review">{{ tab_review }}</a>
          </li>
        {% endif %}
      </ul>
      
      <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-description">
          {{ description }}
        </div>
        
        {% if attribute_groups %}
          <div class="tab-pane fade" id="tab-specification">
            <table class="table table-bordered">
              {% for attribute_group in attribute_groups %}
                <thead>
                  <tr>
                    <td colspan="2"><strong>{{ attribute_group.name }}</strong></td>
                  </tr>
                </thead>
                <tbody>
                  {% for attribute in attribute_group.attribute %}
                    <tr>
                      <td>{{ attribute.name }}</td>
                      <td>{{ attribute.text }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              {% endfor %}
            </table>
          </div>
        {% endif %}
        
        {% if review_status %}
          <div class="tab-pane fade" id="tab-review">
            <div id="review"></div>
          </div>
        {% endif %}
      </div>
    </div>
    
    <!-- Related Products -->
    {% if products %}
      <div class="related-products">
        <h3 class="poppins-semi-bold-eerie-black-32px">{{ text_related }}</h3>
        <div class="cards">
          {% for product in products %}
            <article class="card">
              <div class="info">
                <div class="image">
                  {% if product.thumb %}
                    <a href="{{ product.href }}">
                      <img src="{{ product.thumb }}" alt="{{ product.name }}">
                    </a>
                  {% endif %}
                  <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
                    <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist">
                  </button>
                </div>
                <div class="info-1">
                  <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                    <a href="{{ product.href }}">{{ product.name }}</a>
                  </p>
                  {% if product.model %}
                    <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                  {% endif %}
                </div>
                <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                  {% if product.special %}
                    <span class="price-old">{{ product.price }}</span>
                    <span class="price-new">{{ product.special }}</span>
                  {% else %}
                    {{ product.price }}
                  {% endif %}
                </div>
              </div>
              <div class="button-1">
                <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button-2 poppins-semi-bold-white-16px">
                  {{ button_cart|default('أضف إلى السلة') }}
                </button>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script type="text/javascript">
$('#button-cart').on('click', function() {
  $.ajax({
    url: 'index.php?route=checkout/cart.add',
    type: 'post',
    data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
    dataType: 'json',
    success: function(json) {
      if (json['error']) {
        if (json['error']['option']) {
          for (i in json['error']['option']) {
            var element = $('#input-option' + i.replace('_', '-'));
            if (element.parent().hasClass('input-group')) {
              element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            } else {
              element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            }
          }
        }
      }
      
      if (json['success']) {
        $('#cart-total').html(json['total']);
        
        alert(json['success']);
      }
    }
  });
});
</script>

{{ footer }}
