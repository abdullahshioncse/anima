{{ header }}

<div class="desktop-2 screen">
  <!-- Category Heading -->
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <!-- Product Count -->
  {% if products %}
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/image/line-2-1.svg" alt="Line"/>
    <p class="text-174">تم العثور على {{ product_total }} منتجًا</p>
    <img class="line" src="catalog/view/image/line-2-1.svg" alt="Line"/>
  </div>
  {% endif %}
  
  <!-- Products Grid -->
  <div class="you-may-like">
    <div class="cards">
      {% for product in products %}
      <article class="card">
        <div class="info">
          <div class="image">
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" alt="{{ product.name }}"/>
            </a>
            <button type="button" onclick="wishlist.add('{{ product.product_id }}');">
              <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Wishlist"/>
            </button>
            {% if product.special %}
            <div class="frame-5">
              <div class="button">
                <div class="button-2 poppins-medium-white-14px">تخفيض</div>
              </div>
            </div>
            {% endif %}
          </div>
          <div class="info-1">
            <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
              <a href="{{ product.href }}">{{ product.name }}</a>
            </p>
            <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
          </div>
          <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
            {% if product.special %}
              <span class="price-old">{{ product.price }}</span>
              <span class="price-new">{{ product.special }}</span>
            {% else %}
              {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="button-1">
          <button type="button" onclick="cart.add('{{ product.product_id }}');">
            <div class="button-3 poppins-semi-bold-white-16px">أضف إلى السلة</div>
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
    
    <!-- Pagination -->
    {% if pagination %}
    <div class="pagination">
      {{ pagination }}
    </div>
    {% endif %}
  </div>
  
  <!-- Sub-categories -->
  {% if categories %}
  <div class="categories-section">
    <h2 class="poppins-semi-bold-eerie-black-24px">الفئات</h2>
    <div class="categories-grid">
      {% for category in categories %}
      <div class="category-item">
        <a href="{{ category.href }}">
          {% if category.thumb %}
          <img src="{{ category.thumb }}" alt="{{ category.name }}"/>
          {% endif %}
          <div class="poppins-medium-eerie-black-16px">{{ category.name }}</div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  
  <!-- Category Description -->
  {% if description %}
  <div class="category-description">
    <div class="poppins-medium-eerie-black-16px">
      {{ description }}
    </div>
  </div>
  {% endif %}
</div>

{{ footer }}
