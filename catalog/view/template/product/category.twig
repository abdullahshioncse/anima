{{ header }}

<h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>

<div class="number-1">
  <img class="line-2 line-3" src="catalog/view/image/line-2-1.svg" alt="Line 2" />
  <p class="text-174">تم العثور على {{ product_total }} منتجًا</p>
  <img class="line" src="catalog/view/image/line-2-1.svg" alt="Line 3" />
</div>

<div class="cards">
  {% for product in products %}
  <article class="card">
    <div class="info">
      <div class="image">
        <a href="{{ product.href }}">
          {% if product.thumb %}
          <img src="{{ product.thumb }}" alt="{{ product.name }}" />
          {% endif %}
        </a>
        <img class="iconly-sharp" src="catalog/view/image/iconly-sharp-heart.svg" alt="Iconly/Sharp/Heart" />
        {% if product.special %}
        <div class="frame-5 frame">
          <div class="button"><div class="button-5 poppins-medium-white-14px">مجموعة جديدة</div></div>
        </div>
        {% endif %}
      </div>
      <div class="info-1 info-3">
        <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
          <a href="{{ product.href }}">{{ product.name }}</a>
        </p>
        <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
      </div>
      <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
        {% if product.special %}
        <span class="price-old">{{ product.price }}</span>
        <span class="price-new">{{ product.special }}</span>
        {% else %}
        {{ product.price }}
        {% endif %}
      </div>
    </div>
    <div class="button-1">
      <div class="button-2 poppins-semi-bold-white-16px">
        <button type="button" onclick="cart.add('{{ product.product_id }}');">أضف إلى السلة</button>
      </div>
    </div>
  </article>
  {% endfor %}
</div>

{% if products %}
<div class="pagination">
  {{ pagination }}
</div>
{% endif %}

{{ footer }}
