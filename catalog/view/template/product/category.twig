{{ header }}

<div class="desktop-3 screen">
  <!-- Category Title -->
  <h1 class="text-173 poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <!-- Product Count -->
  <div class="number-1">
    <img class="line-2 line-3" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
    <p class="text-174">{{ text_product_count|default('تم العثور على') }} {{ product_total }} {{ text_products|default('منتجًا') }}</p>
    <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line" />
  </div>
  
  <!-- Products Grid -->
  <div class="cards">
    {% for product in products %}
    <article class="card">
      <div class="info">
        <div class="image">
          <a href="{{ product.href }}">
            {% if product.thumb %}
            <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" />
            {% endif %}
          </a>
          <button type="button" class="iconly-sharp" onclick="wishlist.add('{{ product.product_id }}');">
            <img src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="Wishlist" />
          </button>
          {% if product.special %}
          <div class="frame-5 frame">
            <div class="button">
              <div class="button-5 poppins-medium-white-14px">مجموعة جديدة</div>
            </div>
          </div>
          {% endif %}
        </div>
        <div class="info-1 info-3">
          <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
            <a href="{{ product.href }}">{{ product.name }}</a>
          </p>
          <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
        </div>
        <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
          {% if product.special %}
          <span class="price-old">{{ product.price }}</span>
          <span class="price-new">{{ product.special }}</span>
          {% else %}
          {{ product.price }}
          {% endif %}
        </div>
      </div>
      <div class="button-1">
        <button type="button" class="button-2 poppins-semi-bold-white-16px" onclick="cart.add('{{ product.product_id }}');">
          {{ button_cart|default('أضف إلى السلة') }}
        </button>
      </div>
    </article>
    {% endfor %}
  </div>
  
  <!-- Pagination -->
  {% if pagination %}
  <div class="pagination">{{ pagination }}</div>
  {% endif %}
</div>

{{ footer }}
