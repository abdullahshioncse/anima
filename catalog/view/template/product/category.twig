{{ header }}

<div class="desktop-2 screen">
  <!-- Breadcrumb -->
  {% if breadcrumbs %}
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item">
          {% if not loop.last %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          {% else %}
            {{ breadcrumb.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
  
  <!-- Category Title -->
  <h1 class="text-118 text poppins-semi-bold-eerie-black-40px">{{ heading_title }}</h1>
  
  <!-- Products Found Counter -->
  {% if products %}
    <div class="number">
      <img class="line-2 line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
      <div class="text">{{ text_products_found|replace({'%s': products|length}) }}</div>
      <img class="line" src="catalog/view/theme/anima/image/line-2-1.svg" alt="Line">
    </div>
  {% endif %}
  
  <!-- Category Description -->
  {% if description %}
    <div class="category-description">
      {{ description }}
    </div>
  {% endif %}
  
  <!-- Products Grid -->
  <div class="you-may-like">
    <div class="cards">
      {% if products %}
        {% for product in products %}
          <article class="card">
            <div class="info">
              <div class="image">
                {% if product.thumb %}
                  <a href="{{ product.href }}">
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}">
                  </a>
                {% endif %}
                
                <!-- Wishlist Button -->
                <button type="button" onclick="wishlist.add('{{ product.product_id }}');" class="wishlist-btn">
                  <img class="iconly-sharp" src="catalog/view/theme/anima/image/iconly-sharp-heart.svg" alt="{{ button_wishlist }}">
                </button>
                
                {% if product.special %}
                  <div class="frame-5">
                    <div class="button">
                      <div class="button-2 poppins-medium-white-14px">{{ text_sale|default('تخفيض') }}</div>
                    </div>
                  </div>
                {% endif %}
                
                {% if product.tag and 'new' in product.tag|lower %}
                  <div class="frame-5">
                    <div class="button">
                      <div class="button-2 poppins-medium-white-14px">{{ text_new|default('مجموعة جديدة') }}</div>
                    </div>
                  </div>
                {% endif %}
              </div>
              
              <div class="info-1">
                <p class="t-shirt-energy-red-and-white poppins-medium-eerie-black-12px">
                  <a href="{{ product.href }}">{{ product.name }}</a>
                </p>
                {% if product.model %}
                  <div class="phone poppins-normal-eerie-black-12px">{{ product.model }}</div>
                {% endif %}
              </div>
              
              <div class="x5000-kd poppins-semi-bold-eerie-black-16px">
                {% if product.special %}
                  <span class="price-old">{{ product.price }}</span>
                  <span class="price-new">{{ product.special }}</span>
                {% else %}
                  {{ product.price }}
                {% endif %}
              </div>
            </div>
            
            <div class="button-1">
              <button type="button" onclick="cart.add('{{ product.product_id }}');" class="button-3 poppins-semi-bold-white-16px">
                {{ button_cart|default('أضف إلى السلة') }}
              </button>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <p class="text-center">{{ text_no_results|default('لا توجد منتجات في هذه الفئة.') }}</p>
      {% endif %}
    </div>
  </div>
  
  <!-- Pagination -->
  {% if pagination %}
    <div class="pagination-wrapper">
      {{ pagination }}
    </div>
  {% endif %}
  
  <!-- Sorting and Display Options -->
  <div class="product-options">
    <div class="row">
      <div class="col-md-4">
        <div class="form-group">
          <label class="control-label" for="input-sort">{{ text_sort }}</label>
          <select id="input-sort" class="form-control" onchange="location = this.value;">
            {% for sort_option in sorts %}
              <option value="{{ sort_option.href }}"{% if sort_option.value == sort ~ '-' ~ order %} selected{% endif %}>{{ sort_option.text }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="col-md-4">
        <div class="form-group">
          <label class="control-label" for="input-limit">{{ text_limit }}</label>
          <select id="input-limit" class="form-control" onchange="location = this.value;">
            {% for limit_option in limits %}
              <option value="{{ limit_option.href }}"{% if limit_option.value == limit %} selected{% endif %}>{{ limit_option.text }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

{{ footer }}
